#requires -RunAsAdministrator

# ============================================================
# POWERSHELL 7 BOOTSTRAP
# Installs the latest PowerShell 7 if missing and re-runs
# this script under pwsh. Everything below runs on 7+.
# ============================================================

if ($PSVersionTable.PSVersion.Major -lt 7) {

    $pwsh = Join-Path $env:ProgramFiles "PowerShell\7\pwsh.exe"

    if (-not (Test-Path $pwsh)) {
        Write-Host "PowerShell 7 not found. Installing latest release..."
        [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
        Invoke-Expression "& { $(Invoke-RestMethod -UseBasicParsing https://aka.ms/install-powershell.ps1) } -UseMSI -Quiet"
    }

    if (-not (Test-Path $pwsh)) {
        throw "PowerShell 7 installation failed: $pwsh not found."
    }

    Write-Host "Relaunching under PowerShell 7..."
    & $pwsh -NoProfile -ExecutionPolicy Bypass -File $PSCommandPath @args
    exit $LASTEXITCODE
}

$ErrorActionPreference = "Stop"

# ============================================================
# Propstat
# Windows Server 2025 Production Provisioning
# ============================================================

$InstallDirectory = "C:\propstatInstallScript"
$LogFile          = Join-Path $InstallDirectory "production-provisioning.log"

New-Item -ItemType Directory -Path $InstallDirectory -Force | Out-Null

# ============================================================
# LOGGING
# ============================================================

try {
    Start-Transcript -Path $LogFile -Append | Out-Null
}
catch {
    # Transcript failure must never prevent the provisioning
    # script from continuing.
}

function Write-Log {
    param(
        [Parameter(Mandatory = $true)]
        [AllowEmptyString()]
        [string]$Message,

        [ConsoleColor]$Color = [ConsoleColor]::Gray
    )

    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"

    try {
        Add-Content `
            -Path $LogFile `
            -Value "[$timestamp] $Message" `
            -ErrorAction SilentlyContinue
    }
    catch {}

    Write-Host $Message -ForegroundColor $Color
}

function Write-Section {
    param(
        [Parameter(Mandatory = $true)]
        [string]$Text
    )

    Write-Log ""
    Write-Log "============================================================" Cyan
    Write-Log $Text Cyan
    Write-Log "============================================================" Cyan
}

function Wait-Forever {
    Write-Host ""
    Write-Host "============================================================" -ForegroundColor Yellow
    Write-Host "The provisioning script has stopped." -ForegroundColor Yellow
    Write-Host ""
    Write-Host "The PowerShell window will remain open." -ForegroundColor Yellow
    Write-Host "Log file:" -ForegroundColor Cyan
    Write-Host "  $LogFile" -ForegroundColor Cyan
    Write-Host ""
    Write-Host "Close this window manually when finished." -ForegroundColor Yellow
    Write-Host "============================================================" -ForegroundColor Yellow
    Write-Host ""

    while ($true) {
        Start-Sleep -Seconds 60
    }
}

# ============================================================
# GLOBAL ERROR HANDLER
# ============================================================

trap {
    Write-Host ""
    Write-Host "============================================================" -ForegroundColor Red
    Write-Host "PROVISIONING SCRIPT FAILED" -ForegroundColor Red
    Write-Host "============================================================" -ForegroundColor Red
    Write-Host ""

    try {
        Add-Content -Path $LogFile -Value ""
        Add-Content -Path $LogFile -Value "============================================================"
        Add-Content -Path $LogFile -Value "PROVISIONING SCRIPT FAILED"
        Add-Content -Path $LogFile -Value "============================================================"
        Add-Content -Path $LogFile -Value "Time: $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')"
        Add-Content -Path $LogFile -Value "Error: $($_.Exception.Message)"
        Add-Content -Path $LogFile -Value "Location: $($_.InvocationInfo.PositionMessage)"
        Add-Content -Path $LogFile -Value ($_ | Out-String)
    }
    catch {}

    Write-Host "Error:" -ForegroundColor Yellow
    Write-Host $_.Exception.Message -ForegroundColor Red
    Write-Host ""
    Write-Host "Location:" -ForegroundColor Yellow
    Write-Host $_.InvocationInfo.PositionMessage -ForegroundColor Red
    Write-Host ""
    Write-Host "Log file:" -ForegroundColor Cyan
    Write-Host $LogFile -ForegroundColor Cyan

    try {
        Stop-Transcript | Out-Null
    }
    catch {}

    Wait-Forever
}

# ============================================================
# INPUT HELPERS
# ============================================================

function Read-YesNo {

    param(
        [Parameter(Mandatory = $true)]
        [string]$Prompt,

        [bool]$Default = $false
    )

    $suffix = if ($Default) { "[Y/n]" } else { "[y/N]" }

    while ($true) {

        $answer = Read-Host "$Prompt $suffix"

        if ([string]::IsNullOrWhiteSpace($answer)) {
            return $Default
        }

        if ($answer -match '^(?i)y(es)?$') { return $true }
        if ($answer -match '^(?i)no?$')    { return $false }

        Write-Host "Please answer y or n." -ForegroundColor Yellow
    }
}

function Test-IPv4Address {

    param(
        [string]$Address
    )

    $parsed = $null

    return (
        $Address -match '^\d{1,3}(\.\d{1,3}){3}$' -and
        [System.Net.IPAddress]::TryParse($Address, [ref]$parsed) -and
        $parsed.AddressFamily -eq [System.Net.Sockets.AddressFamily]::InterNetwork
    )
}

function Read-IPv4Address {

    # Reads one IPv4 address. ENTER returns the default; with no
    # default, ENTER returns $null when -Optional is set.

    param(
        [Parameter(Mandatory = $true)]
        [string]$Prompt,

        [string]$Default,

        [switch]$Optional
    )

    $label =
        if ($Default)      { "$Prompt [$Default]" }
        elseif ($Optional) { "$Prompt (ENTER for none)" }
        else               { $Prompt }

    while ($true) {

        $value = (Read-Host $label).Trim()

        if (-not $value) {
            if ($Default)  { return $Default }
            if ($Optional) { return $null }
            Write-Host "A value is required." -ForegroundColor Yellow
            continue
        }

        if (Test-IPv4Address $value) {
            return $value
        }

        Write-Host "'$value' is not a valid IPv4 address." -ForegroundColor Yellow
    }
}

function Read-IPv4AddressList {

    # Reads a comma separated list of IPv4 addresses. ENTER returns
    # the default list.

    param(
        [Parameter(Mandatory = $true)]
        [string]$Prompt,

        [string[]]$Default = @()
    )

    $label =
        if ($Default.Count -gt 0) { "$Prompt [$($Default -join ', ')]" }
        else                      { "$Prompt (comma separated, ENTER for none)" }

    while ($true) {

        $value = (Read-Host $label).Trim()

        if (-not $value) {
            return ,$Default
        }

        $addresses = @(
            $value -split '[,; ]+' |
                Where-Object { $_ }
        )

        $invalid = @($addresses | Where-Object { -not (Test-IPv4Address $_) })

        if ($invalid.Count -eq 0) {
            return ,$addresses
        }

        Write-Host "Not a valid IPv4 address: $($invalid -join ', ')" -ForegroundColor Yellow
    }
}

function ConvertTo-PrefixLength {

    # Accepts a subnet mask (255.255.255.0) or a prefix length
    # (24 or /24) and returns the prefix length, or $null if the
    # input is invalid.

    param(
        [string]$Value
    )

    $Value = $Value.Trim()

    if ($Value -match '^/?(\d{1,2})$') {

        $prefix = [int]$Matches[1]

        if ($prefix -ge 1 -and $prefix -le 32) {
            return $prefix
        }

        return $null
    }

    if (-not (Test-IPv4Address $Value)) {
        return $null
    }

    $binary = (
        $Value.Split(".") |
            ForEach-Object { [Convert]::ToString([int]$_, 2).PadLeft(8, "0") }
    ) -join ""

    if ($binary -notmatch '^1+0*$') {
        return $null
    }

    return $binary.IndexOf("0") -eq -1 ? 32 : $binary.IndexOf("0")
}

function ConvertTo-SubnetMask {

    param(
        [Parameter(Mandatory = $true)]
        [int]$PrefixLength
    )

    $binary = ("1" * $PrefixLength).PadRight(32, "0")

    return (
        0..3 |
            ForEach-Object { [Convert]::ToInt32($binary.Substring($_ * 8, 8), 2) }
    ) -join "."
}

function Read-PrefixLength {

    param(
        [int]$Default = 0
    )

    $label =
        if ($Default -gt 0) { "Subnet mask [$(ConvertTo-SubnetMask $Default)]" }
        else                { "Subnet mask (e.g. 255.255.255.0 or /24)" }

    while ($true) {

        $value = (Read-Host $label).Trim()

        if (-not $value -and $Default -gt 0) {
            return $Default
        }

        $prefix = ConvertTo-PrefixLength $value

        if ($prefix) {
            return $prefix
        }

        Write-Host "'$value' is not a valid subnet mask or prefix length." -ForegroundColor Yellow
    }
}

# ============================================================
# NETWORK HELPERS
# ============================================================

function Get-AdapterList {

    return @(
        Get-NetAdapter |
            Sort-Object ifIndex
    )
}

function Show-NetworkAdapters {

    $adapters = Get-AdapterList

    Write-Log ""
    Write-Log ("{0,-4} {1,-24} {2,-19} {3,-13} {4,-18} {5,-5} {6}" -f `
        "#", "Name", "MAC address", "Status", "IPv4", "DHCP", "Description") Cyan

    for ($i = 0; $i -lt $adapters.Count; $i++) {

        $adapter = $adapters[$i]

        $ipv4 = (
            Get-NetIPAddress `
                -InterfaceIndex $adapter.ifIndex `
                -AddressFamily IPv4 `
                -ErrorAction SilentlyContinue |
                ForEach-Object { "$($_.IPAddress)/$($_.PrefixLength)" }
        ) -join ", "

        $dhcp = (
            Get-NetIPInterface `
                -InterfaceIndex $adapter.ifIndex `
                -AddressFamily IPv4 `
                -ErrorAction SilentlyContinue
        ).Dhcp

        Write-Log ("{0,-4} {1,-24} {2,-19} {3,-13} {4,-18} {5,-5} {6}" -f `
            "[$($i + 1)]",
            $adapter.Name,
            $adapter.MacAddress,
            $adapter.Status,
            ($ipv4 ? $ipv4 : "-"),
            $dhcp,
            $adapter.InterfaceDescription)
    }

    Write-Log ""

    return $adapters
}

function Select-Adapter {

    # Returns the selected adapter, or $null when ENTER is pressed.

    param(
        [Parameter(Mandatory = $true)]
        [object[]]$Adapters,

        [Parameter(Mandatory = $true)]
        [string]$Prompt
    )

    while ($true) {

        $selection = (Read-Host "$Prompt (1-$($Adapters.Count), ENTER when done)").Trim()

        if (-not $selection) {
            return $null
        }

        $number = 0

        if ([int]::TryParse($selection, [ref]$number) -and
            $number -ge 1 -and
            $number -le $Adapters.Count) {

            return $Adapters[$number - 1]
        }

        Write-Host "Please enter a number from 1 to $($Adapters.Count)." -ForegroundColor Yellow
    }
}

function Get-CurrentIPv4Settings {

    # Current IPv4 values of an adapter (from DHCP or static).

    param(
        [Parameter(Mandatory = $true)]
        [int]$InterfaceIndex
    )

    $address =
        Get-NetIPAddress `
            -InterfaceIndex $InterfaceIndex `
            -AddressFamily IPv4 `
            -ErrorAction SilentlyContinue |
            Where-Object { $_.IPAddress -notlike "169.254.*" } |
            Select-Object -First 1

    $gateway = (
        Get-NetRoute `
            -InterfaceIndex $InterfaceIndex `
            -AddressFamily IPv4 `
            -DestinationPrefix "0.0.0.0/0" `
            -ErrorAction SilentlyContinue |
            Sort-Object RouteMetric |
            Select-Object -First 1
    ).NextHop

    $dns = @(
        (Get-DnsClientServerAddress `
            -InterfaceIndex $InterfaceIndex `
            -AddressFamily IPv4 `
            -ErrorAction SilentlyContinue).ServerAddresses
    )

    $dhcp = (
        Get-NetIPInterface `
            -InterfaceIndex $InterfaceIndex `
            -AddressFamily IPv4 `
            -ErrorAction SilentlyContinue
    ).Dhcp

    return [pscustomobject]@{
        Dhcp         = $dhcp -eq "Enabled"
        IPAddress    = $address.IPAddress
        PrefixLength = [int]$address.PrefixLength
        Gateway      = $gateway
        DnsServers   = $dns
    }
}

function Clear-AdapterIPv4 {

    param(
        [Parameter(Mandatory = $true)]
        [int]$InterfaceIndex
    )

    Get-NetIPAddress `
        -InterfaceIndex $InterfaceIndex `
        -AddressFamily IPv4 `
        -ErrorAction SilentlyContinue |
        Remove-NetIPAddress `
            -Confirm:$false `
            -ErrorAction SilentlyContinue

    Get-NetRoute `
        -InterfaceIndex $InterfaceIndex `
        -AddressFamily IPv4 `
        -DestinationPrefix "0.0.0.0/0" `
        -ErrorAction SilentlyContinue |
        Remove-NetRoute `
            -Confirm:$false `
            -ErrorAction SilentlyContinue
}

# ============================================================
# START
# ============================================================

Write-Log "============================================================" Cyan
Write-Log "Propstat Windows Server 2025 Production Provisioning" Cyan
Write-Log "Started: $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')" Cyan
Write-Log "Log file: $LogFile" Cyan
Write-Log "============================================================" Cyan

# ============================================================
# 1. COMPUTER NAME
# ============================================================

Write-Section "Computer Name"

# The name is applied later together with the (optional) domain
# join, so both take effect with the final reboot.

$currentComputerName = $env:COMPUTERNAME

do {

    $computerName = (Read-Host "Computer name [$currentComputerName]").Trim()

    if (-not $computerName) {
        $computerName = $currentComputerName
    }

    if (
        $computerName.Length -gt 15 -or
        $computerName -notmatch '^[A-Za-z0-9][A-Za-z0-9-]*[A-Za-z0-9]$' -or
        $computerName -match '^\d+$'
    ) {
        Write-Log "Invalid computer name. Maximum 15 characters; letters, numbers and hyphens; not only digits." Yellow
        $computerName = $null
    }

}
while (-not $computerName)

$renameComputer = $computerName -ne $currentComputerName

Write-Log "Computer name: $computerName$(if ($renameComputer) { " (currently $currentComputerName)" })" Green

# ============================================================
# 2. NETWORK ADAPTERS
# ============================================================

Write-Section "Network Adapters"

$adapters = @(Show-NetworkAdapters)

if ($adapters.Count -eq 0) {
    throw "No network adapters were found."
}

# ============================================================
# 3. RENAME NETWORK ADAPTERS
# ============================================================

Write-Section "Rename Network Adapters"

while ($true) {

    $adapter = Select-Adapter -Adapters $adapters -Prompt "Adapter to rename"

    if (-not $adapter) {
        break
    }

    $newName = (Read-Host "New name for '$($adapter.Name)' ($($adapter.MacAddress))").Trim()

    if (-not $newName -or $newName -eq $adapter.Name) {
        Write-Log "Name unchanged."
        continue
    }

    if ($newName -match '[\\/:*?"<>|]') {
        Write-Log "Adapter names cannot contain \ / : * ? `" < > |" Yellow
        continue
    }

    if (Get-NetAdapter -Name $newName -ErrorAction SilentlyContinue) {
        Write-Log "An adapter named '$newName' already exists." Yellow
        continue
    }

    Rename-NetAdapter `
        -Name $adapter.Name `
        -NewName $newName

    Write-Log "Adapter renamed: $($adapter.Name) -> $newName ($($adapter.MacAddress))" Green

    $adapters = @(Show-NetworkAdapters)
}

# ============================================================
# 4. IP CONFIGURATION
# ============================================================

Write-Section "IP Configuration"

Write-Host "Choose an adapter to configure. For each adapter:" -ForegroundColor Cyan
Write-Host "  [1] DHCP        IP, subnet mask, gateway and DNS from DHCP"
Write-Host "  [2] Static      IP and subnet mask manual, gateway and DNS"
Write-Host "                  proposed from the current DHCP lease (ENTER accepts)"
Write-Host "  [3] Manual      IP, subnet mask, gateway and DNS all manual"
Write-Host ""
Write-Host "Changing the adapter of your current remote session may disconnect you." -ForegroundColor DarkGray
Write-Host "The script keeps running on the server." -ForegroundColor DarkGray
Write-Host ""

while ($true) {

    $adapter = Select-Adapter -Adapters $adapters -Prompt "Adapter to configure"

    if (-not $adapter) {
        break
    }

    $current = Get-CurrentIPv4Settings -InterfaceIndex $adapter.ifIndex

    Write-Log "Adapter: $($adapter.Name) ($($adapter.MacAddress))"
    Write-Log "  Current: $(if ($current.Dhcp) { 'DHCP' } else { 'static' }), IP $($current.IPAddress)/$($current.PrefixLength), gateway $($current.Gateway), DNS $($current.DnsServers -join ', ')"

    do {
        $mode = (Read-Host "Mode [1] DHCP, [2] Static (DHCP gateway/DNS), [3] Manual").Trim()
    }
    while ($mode -notin @("1", "2", "3"))

    if ($mode -eq "1") {

        Clear-AdapterIPv4 -InterfaceIndex $adapter.ifIndex

        Set-NetIPInterface `
            -InterfaceIndex $adapter.ifIndex `
            -AddressFamily IPv4 `
            -Dhcp Enabled

        Set-DnsClientServerAddress `
            -InterfaceIndex $adapter.ifIndex `
            -ResetServerAddresses

        Write-Log "$($adapter.Name): DHCP enabled for IP, gateway and DNS." Green
    }
    else {

        if ($mode -eq "2" -and -not $current.Dhcp) {
            Write-Log "$($adapter.Name) is not using DHCP; its current gateway and DNS are proposed instead." Yellow
        }

        # Mode 2 proposes the current gateway/DNS (from the DHCP
        # lease); mode 3 proposes nothing.

        $proposeCurrent = $mode -eq "2"

        $ipAddress =
            Read-IPv4Address `
                -Prompt "IPv4 address" `
                -Default ($proposeCurrent ? $current.IPAddress : $null)

        $prefixLength =
            Read-PrefixLength `
                -Default ($proposeCurrent ? $current.PrefixLength : 0)

        $gateway =
            Read-IPv4Address `
                -Prompt "Default gateway" `
                -Default ($proposeCurrent ? $current.Gateway : $null) `
                -Optional

        $dnsServers =
            Read-IPv4AddressList `
                -Prompt "DNS server(s)" `
                -Default ($proposeCurrent ? $current.DnsServers : @())

        Write-Host ""
        Write-Host "  Adapter:     $($adapter.Name)"
        Write-Host "  IP address:  $ipAddress"
        Write-Host "  Subnet mask: $(ConvertTo-SubnetMask $prefixLength) (/$prefixLength)"
        Write-Host "  Gateway:     $(if ($gateway) { $gateway } else { '(none)' })"
        Write-Host "  DNS:         $(if ($dnsServers.Count) { $dnsServers -join ', ' } else { '(none)' })"
        Write-Host ""

        if (-not (Read-YesNo -Prompt "Apply this configuration?" -Default $true)) {
            Write-Log "$($adapter.Name): configuration not applied."
            continue
        }

        Clear-AdapterIPv4 -InterfaceIndex $adapter.ifIndex

        Set-NetIPInterface `
            -InterfaceIndex $adapter.ifIndex `
            -AddressFamily IPv4 `
            -Dhcp Disabled

        $ipParameters = @{
            InterfaceIndex = $adapter.ifIndex
            IPAddress      = $ipAddress
            PrefixLength   = $prefixLength
        }

        if ($gateway) {
            $ipParameters.DefaultGateway = $gateway
        }

        New-NetIPAddress @ipParameters | Out-Null

        if ($dnsServers.Count -gt 0) {
            Set-DnsClientServerAddress `
                -InterfaceIndex $adapter.ifIndex `
                -ServerAddresses $dnsServers
        }
        else {
            Set-DnsClientServerAddress `
                -InterfaceIndex $adapter.ifIndex `
                -ResetServerAddresses
        }

        Write-Log "$($adapter.Name): static $ipAddress/$prefixLength, gateway $(if ($gateway) { $gateway } else { 'none' }), DNS $(if ($dnsServers.Count) { $dnsServers -join ', ' } else { 'none' })" Green
    }

    $adapters = @(Show-NetworkAdapters)
}

# ============================================================
# 5. DOMAIN JOIN (OPTIONAL)
# ============================================================

Write-Section "Domain Join"

$domainJoined = $false

$computerSystem = Get-CimInstance -ClassName Win32_ComputerSystem

if ($computerSystem.PartOfDomain) {
    Write-Log "This computer is already a member of $($computerSystem.Domain). Domain join skipped." Yellow
}
elseif (Read-YesNo -Prompt "Join this computer to a domain?" -Default $false) {

    do {
        $domainName = (Read-Host "Domain name (e.g. corp.example.com)").Trim()
    }
    while ($domainName -notmatch '^[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)+$')

    # A domain controller must be findable via DNS before joining.

    try {
        $dcRecords = @(
            Resolve-DnsName `
                -Name "_ldap._tcp.dc._msdcs.$domainName" `
                -Type SRV `
                -DnsOnly `
                -ErrorAction Stop |
                Where-Object { $_.Type -eq "SRV" }
        )

        Write-Log "Domain controllers found for ${domainName}:" Green
        foreach ($record in $dcRecords) {
            Write-Log "  $($record.NameTarget)"
        }

        $domainReachable = $true
    }
    catch {
        Write-Log "No domain controller found for $domainName in DNS: $($_.Exception.Message)" Yellow
        Write-Log "Check that the DNS servers of this computer point to the domain's DNS." Yellow
        $domainReachable = Read-YesNo -Prompt "Try to join anyway?" -Default $false
    }

    if ($domainReachable) {

        $ouPath = (Read-Host "OU distinguished name (ENTER for default Computers container)").Trim()

        $credential = Get-Credential -Message "Account allowed to join computers to $domainName"

        $userName = $credential.UserName

        if ($userName -notmatch '[\\@]') {
            $userName = "$domainName\$userName"
        }

        # The computer is renamed first (without reboot) and then
        # joined with the new name, like Add-Computer -NewName.
        # Add-Computer is not available in PowerShell 7, so the
        # Win32_ComputerSystem.JoinDomainOrWorkgroup method is used.
        #   1     = join domain
        #   2     = create computer account
        #   1024  = join with new (pending) computer name

        if ($renameComputer) {
            Rename-Computer -NewName $computerName -Force -WarningAction SilentlyContinue
            Write-Log "Computer will be renamed to $computerName." Green
            $renameComputer = $false
        }

        $joinOptions = 1 + 2 + 1024

        $joinArguments = @{
            Name          = $domainName
            UserName      = $userName
            Password      = $credential.GetNetworkCredential().Password
            FJoinOptions  = [uint32]$joinOptions
        }

        if ($ouPath) {
            $joinArguments.AccountOU = $ouPath
        }

        Write-Log "Joining $domainName as $userName$(if ($ouPath) { " into $ouPath" })..."

        $joinResult =
            Invoke-CimMethod `
                -InputObject $computerSystem `
                -MethodName JoinDomainOrWorkgroup `
                -Arguments $joinArguments

        $joinArguments.Password = $null

        $joinErrors = @{
            5    = "Access denied."
            53   = "Network path not found."
            87   = "Invalid parameter (check the OU path)."
            1326 = "Logon failure: unknown user name or bad password."
            1355 = "The domain does not exist or could not be contacted."
            2224 = "The computer account already exists."
            2691 = "The computer is already joined to a domain."
        }

        if ($joinResult.ReturnValue -ne 0) {

            $reason =
                $joinErrors[[int]$joinResult.ReturnValue] ??
                "See https://learn.microsoft.com/windows/win32/debug/system-error-codes"

            throw "Domain join failed with code $($joinResult.ReturnValue): $reason"
        }

        $domainJoined = $true

        Write-Log "Computer joined to $domainName. The join completes with the reboot." Green
    }
}
else {
    Write-Log "Domain join skipped."
}

if ($renameComputer) {
    Rename-Computer -NewName $computerName -Force -WarningAction SilentlyContinue
    Write-Log "Computer will be renamed to $computerName." Green
}

# ============================================================
# 6. WINDOWS UPDATE
# ============================================================

Write-Section "Windows Update"

# The update script runs in passes until no updates are left.
# It runs once now; if updates remain after a reboot (e.g.
# servicing stack or cumulative updates), a startup task keeps
# running it after each reboot and removes itself when done.

$updateScript  = Join-Path $InstallDirectory "Production-WindowsUpdate.ps1"
$updateLog     = Join-Path $InstallDirectory "Production-WindowsUpdate.log"
$updateState   = Join-Path $InstallDirectory "Production-WindowsUpdate.passes"
$updateTask    = "Propstat-Production-WindowsUpdate"

$updateContent = @'
param(
    [switch]$Interactive,
    [int]$MaxPasses = 10
)

$ErrorActionPreference = "Stop"

$InstallDirectory = "C:\propstatInstallScript"
$LogFile          = Join-Path $InstallDirectory "Production-WindowsUpdate.log"
$StateFile        = Join-Path $InstallDirectory "Production-WindowsUpdate.passes"
$TaskName         = "Propstat-Production-WindowsUpdate"

function Write-UpdateLog {
    param([string]$Message, [ConsoleColor]$Color = [ConsoleColor]::Gray)
    Add-Content -Path $LogFile -Value "[$(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')] $Message" -ErrorAction SilentlyContinue
    if ($Interactive) { Write-Host $Message -ForegroundColor $Color }
}

function Remove-UpdateTask {
    Unregister-ScheduledTask -TaskName $TaskName -Confirm:$false -ErrorAction SilentlyContinue
    Remove-Item -Path $StateFile -Force -ErrorAction SilentlyContinue
    Write-UpdateLog "Update task removed."
}

function Invoke-UpdatePass {

    $session  = New-Object -ComObject Microsoft.Update.Session
    $searcher = $session.CreateUpdateSearcher()

    Write-UpdateLog "Searching for updates..."

    $updates = @(
        $searcher.Search("IsInstalled=0 and IsHidden=0 and Type='Software'").Updates
    )

    Write-UpdateLog "Updates found: $($updates.Count)"

    if ($updates.Count -eq 0) {
        return [pscustomobject]@{ Found = 0; Installed = 0; RebootRequired = $false }
    }

    $collection = New-Object -ComObject Microsoft.Update.UpdateColl

    foreach ($update in $updates) {
        try {
            if (-not $update.EulaAccepted) { $update.AcceptEula() }
        }
        catch {}

        Write-UpdateLog "  $($update.Title)"
        [void]$collection.Add($update)
    }

    Write-UpdateLog "Downloading updates..."

    $downloader = $session.CreateUpdateDownloader()
    $downloader.Updates = $collection
    $downloadResult = $downloader.Download()

    Write-UpdateLog "Download result: $($downloadResult.ResultCode)"

    Write-UpdateLog "Installing updates..."

    $installer = $session.CreateUpdateInstaller()
    $installer.Updates = $collection
    $installResult = $installer.Install()

    $installed = 0

    for ($i = 0; $i -lt $collection.Count; $i++) {

        # 2 = succeeded, 3 = succeeded with errors
        $code = $installResult.GetUpdateResult($i).ResultCode

        if ($code -in 2, 3) {
            $installed++
        }
        else {
            Write-UpdateLog "  Not installed (result $code): $($collection.Item($i).Title)" Yellow
        }
    }

    Write-UpdateLog "Installed: $installed of $($collection.Count), reboot required: $($installResult.RebootRequired)"

    return [pscustomobject]@{
        Found          = $collection.Count
        Installed      = $installed
        RebootRequired = [bool]$installResult.RebootRequired
    }
}

$passCount = 0

if (Test-Path $StateFile) {
    $passCount = [int](Get-Content -Path $StateFile -Raw)
}

$complete = $false

try {

    if (-not $Interactive) {
        # Give Windows time to start its services after boot.
        Start-Sleep -Seconds 60
    }

    while ($true) {

        if ($passCount -ge $MaxPasses) {
            Write-UpdateLog "Maximum of $MaxPasses update passes reached. Stopping." Yellow
            if (-not $Interactive) { Remove-UpdateTask }
            break
        }

        $passCount++
        Set-Content -Path $StateFile -Value $passCount

        Write-UpdateLog "=== Windows Update pass $passCount ===" Cyan

        $result = Invoke-UpdatePass

        if ($result.Found -eq 0) {
            Write-UpdateLog "All updates are installed." Green
            $complete = $true
            if (-not $Interactive) { Remove-UpdateTask }
            break
        }

        if ($result.RebootRequired) {

            if ($Interactive) {
                Write-UpdateLog "A reboot is required to continue." Yellow
                break
            }

            Write-UpdateLog "Rebooting to continue with the next pass."
            Restart-Computer -Force
            exit
        }

        if ($result.Installed -eq 0) {
            Write-UpdateLog "No update could be installed in this pass. Stopping." Yellow
            if (-not $Interactive) { Remove-UpdateTask }
            break
        }
    }
}
catch {
    Write-UpdateLog "ERROR: $($_.Exception.Message)" Red
    if (-not $Interactive) { Remove-UpdateTask }
}

if ($Interactive) {
    return [pscustomobject]@{ Complete = $complete }
}
'@

Set-Content `
    -Path $updateScript `
    -Value $updateContent `
    -Encoding UTF8

Remove-Item -Path $updateState -Force -ErrorAction SilentlyContinue

$updateRun = & $updateScript -Interactive

if ($updateRun.Complete) {

    Write-Log "Windows is fully up to date." Green
}
else {

    # Continue after the reboot until all updates are installed.

    $updateAction =
        New-ScheduledTaskAction `
            -Execute (Join-Path $env:ProgramFiles "PowerShell\7\pwsh.exe") `
            -Argument "-NoProfile -ExecutionPolicy Bypass -File `"$updateScript`""

    $updateTrigger =
        New-ScheduledTaskTrigger `
            -AtStartup

    $updatePrincipal =
        New-ScheduledTaskPrincipal `
            -UserId "SYSTEM" `
            -LogonType ServiceAccount `
            -RunLevel Highest

    $updateSettings =
        New-ScheduledTaskSettingsSet `
            -StartWhenAvailable `
            -ExecutionTimeLimit (New-TimeSpan -Hours 4)

    Register-ScheduledTask `
        -TaskName $updateTask `
        -Description "Installs remaining Windows updates after each reboot and removes itself when done." `
        -Action $updateAction `
        -Trigger $updateTrigger `
        -Principal $updatePrincipal `
        -Settings $updateSettings `
        -Force |
        Out-Null

    Write-Log "More updates will be installed after the reboot." Yellow
    Write-Log "  Task: $updateTask (removes itself when done)"
    Write-Log "  Log:  $updateLog"
}

# ============================================================
# 7. DESKTOP CLEANUP
# ============================================================

Write-Section "Desktop Cleanup"

# Template-only shortcuts are removed from the all users desktop:
# every shortcut whose name contains "sysprep" or
# "Arm for Production" (any upper/lower case).

$publicDesktop =
    [Environment]::GetFolderPath("CommonDesktopDirectory")

$templateShortcuts = @(
    Get-ChildItem -Path $publicDesktop -File -Force -ErrorAction SilentlyContinue |
        Where-Object {
            $_.Extension -in ".lnk", ".url" -and (
                $_.BaseName -like "*sysprep*" -or
                $_.BaseName -like "*Arm for Production*"
            )
        }
)

if ($templateShortcuts.Count -eq 0) {
    Write-Log "No template shortcuts found on $publicDesktop."
}

foreach ($shortcut in $templateShortcuts) {

    try {
        Remove-Item -LiteralPath $shortcut.FullName -Force
        Write-Log "Shortcut removed: $($shortcut.Name)" Green
    }
    catch {
        Write-Log "Shortcut $($shortcut.Name) could not be removed: $($_.Exception.Message)" Yellow
    }
}

# ============================================================
# 8. REBOOT
# ============================================================

Write-Section "Reboot"

Write-Log "Production provisioning is complete." Green
Write-Log "  Computer name: $computerName"
Write-Log "  Domain:        $(if ($domainJoined) { $domainName } else { 'not joined' })"
Write-Log ""
Write-Log "The system will reboot in 15 seconds."

for ($i = 15; $i -gt 0; $i--) {

    Write-Host "`rRebooting in $i seconds... " -NoNewline
    Start-Sleep -Seconds 1
}

Write-Host ""
Write-Log "Rebooting now..." Yellow

try {
    Stop-Transcript | Out-Null
}
catch {}

try {
    Restart-Computer -Force
}
catch {
    Write-Host ""
    Write-Host "REBOOT FAILED: $($_.Exception.Message)" -ForegroundColor Red
    Wait-Forever
}

# If Restart-Computer unexpectedly returns, do not close.
Wait-Forever