#requires -RunAsAdministrator

# ============================================================
# POWERSHELL 7 BOOTSTRAP
# Installs the latest PowerShell 7 if missing and re-runs
# this script under pwsh. Everything below runs on 7+.
# ============================================================

if ($PSVersionTable.PSVersion.Major -lt 7) {

    $pwsh = Join-Path $env:ProgramFiles "PowerShell\7\pwsh.exe"

    if (-not (Test-Path $pwsh)) {
        Write-Host "PowerShell 7 not found. Installing latest release..."
        [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
        Invoke-Expression "& { $(Invoke-RestMethod -UseBasicParsing https://aka.ms/install-powershell.ps1) } -UseMSI -Quiet"
    }

    if (-not (Test-Path $pwsh)) {
        throw "PowerShell 7 installation failed: $pwsh not found."
    }

    Write-Host "Relaunching under PowerShell 7..."
    & $pwsh -NoProfile -ExecutionPolicy Bypass -File $PSCommandPath @args
    exit $LASTEXITCODE
}

$ErrorActionPreference = "Stop"

# ============================================================
# Propstat
# Windows Server 2025 Vanilla Provisioning
# ============================================================

$InstallDirectory = "C:\propstatInstallScript"
$VirtIODirectory   = Join-Path $InstallDirectory "VirtIO"
$LogFile           = Join-Path $InstallDirectory "vanilla-provisioning.log"

New-Item -ItemType Directory -Path $InstallDirectory -Force | Out-Null
New-Item -ItemType Directory -Path $VirtIODirectory -Force | Out-Null

# ============================================================
# LOGGING
# ============================================================

try {
    Start-Transcript -Path $LogFile -Append | Out-Null
}
catch {
    # Transcript failure must never prevent the provisioning
    # script from continuing.
}

function Write-Log {
    param(
        [Parameter(Mandatory = $true)]
        [AllowEmptyString()]
        [string]$Message,

        [ConsoleColor]$Color = [ConsoleColor]::Gray
    )

    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"

    try {
        Add-Content `
            -Path $LogFile `
            -Value "[$timestamp] $Message" `
            -ErrorAction SilentlyContinue
    }
    catch {}

    Write-Host $Message -ForegroundColor $Color
}

function Write-Section {
    param(
        [Parameter(Mandatory = $true)]
        [string]$Text
    )

    Write-Log ""
    Write-Log "============================================================" Cyan
    Write-Log $Text Cyan
    Write-Log "============================================================" Cyan
}

function Wait-Forever {
    Write-Host ""
    Write-Host "============================================================" -ForegroundColor Yellow
    Write-Host "The provisioning script has stopped." -ForegroundColor Yellow
    Write-Host ""
    Write-Host "The PowerShell window will remain open." -ForegroundColor Yellow
    Write-Host "Log file:" -ForegroundColor Cyan
    Write-Host "  $LogFile" -ForegroundColor Cyan
    Write-Host ""
    Write-Host "Close this window manually when finished." -ForegroundColor Yellow
    Write-Host "============================================================" -ForegroundColor Yellow
    Write-Host ""

    while ($true) {
        Start-Sleep -Seconds 60
    }
}

# ============================================================
# GLOBAL ERROR HANDLER
# ============================================================

trap {
    Write-Host ""
    Write-Host "============================================================" -ForegroundColor Red
    Write-Host "PROVISIONING SCRIPT FAILED" -ForegroundColor Red
    Write-Host "============================================================" -ForegroundColor Red
    Write-Host ""

    try {
        Add-Content `
            -Path $LogFile `
            -Value ""
        Add-Content `
            -Path $LogFile `
            -Value "============================================================"
        Add-Content `
            -Path $LogFile `
            -Value "PROVISIONING SCRIPT FAILED"
        Add-Content `
            -Path $LogFile `
            -Value "============================================================"
        Add-Content `
            -Path $LogFile `
            -Value "Time: $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')"
        Add-Content `
            -Path $LogFile `
            -Value "Error: $($_.Exception.Message)"
        Add-Content `
            -Path $LogFile `
            -Value "Location: $($_.InvocationInfo.PositionMessage)"
        Add-Content `
            -Path $LogFile `
            -Value ($_ | Out-String)
    }
    catch {}

    Write-Host "Error:" -ForegroundColor Yellow
    Write-Host $_.Exception.Message -ForegroundColor Red
    Write-Host ""
    Write-Host "Location:" -ForegroundColor Yellow
    Write-Host $_.InvocationInfo.PositionMessage -ForegroundColor Red
    Write-Host ""
    Write-Host "Full error:" -ForegroundColor Yellow
    Write-Host ($_ | Out-String) -ForegroundColor Red
    Write-Host ""
    Write-Host "Log file:" -ForegroundColor Cyan
    Write-Host $LogFile -ForegroundColor Cyan

    try {
        Stop-Transcript | Out-Null
    }
    catch {}

    Wait-Forever
}

Write-Log "============================================================" Cyan
Write-Log "Propstat Windows Server 2025 Vanilla Provisioning" Cyan
Write-Log "Started: $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')" Cyan
Write-Log "Install directory: $InstallDirectory" Cyan
Write-Log "Log file: $LogFile" Cyan
Write-Log "============================================================" Cyan

# ============================================================
# NETWORK TEST
# ============================================================

# Connectivity target: Cloudflare DNS over HTTPS port.
$NetworkTestHost = "1.1.1.1"
$NetworkTestPort = 443

# The test message is only shown the first time.
$script:NetworkTestAnnounced = $false

function Test-TcpPort {

    param(
        [Parameter(Mandatory = $true)]
        [string]$HostName,

        [Parameter(Mandatory = $true)]
        [int]$Port,

        [int]$TimeoutMilliseconds = 3000
    )

    # Plain TCP connect instead of Test-NetConnection: no progress
    # banner, and a failed attempt returns after the timeout.
    $client = New-Object System.Net.Sockets.TcpClient

    try {
        return $client.ConnectAsync($HostName, $Port).Wait($TimeoutMilliseconds) -and
               $client.Connected
    }
    catch {
        return $false
    }
    finally {
        $client.Dispose()
    }
}

function Test-ActiveNetwork {

    if (-not $script:NetworkTestAnnounced) {
        Write-Log "Testing Internet connectivity ($NetworkTestHost port $NetworkTestPort)..."
        $script:NetworkTestAnnounced = $true
    }

    $adapters = @(
        Get-NetAdapter -ErrorAction SilentlyContinue |
            Where-Object {
                $_.Status -eq "Up" -and
                $_.HardwareInterface -eq $true
            }
    )

    foreach ($adapter in $adapters) {

        $ipAddresses = @(
            Get-NetIPAddress `
                -InterfaceIndex $adapter.ifIndex `
                -AddressFamily IPv4 `
                -ErrorAction SilentlyContinue |
                Where-Object {
                    $_.IPAddress -notlike "169.254.*" -and
                    $_.IPAddress -notlike "127.*"
                }
        )

        if ($ipAddresses.Count -eq 0) {
            continue
        }

        if (Test-TcpPort -HostName $NetworkTestHost -Port $NetworkTestPort) {
            return $true
        }
    }

    return $false
}

# DNS test target: the host all downloads come from.
$DnsTestHost = "raw.githubusercontent.com"

function Test-DnsResolution {

    param(
        [string]$HostName = $DnsTestHost,

        [int]$TimeoutMilliseconds = 5000
    )

    Write-Log "Testing DNS resolution ($HostName)..."

    try {
        $lookup = [System.Net.Dns]::GetHostAddressesAsync($HostName)

        if ($lookup.Wait($TimeoutMilliseconds) -and $lookup.Result.Count -gt 0) {
            Write-Log "  $HostName -> $(($lookup.Result | ForEach-Object IPAddressToString) -join ', ')" Green
            return $true
        }

        Write-Log "  DNS lookup for $HostName timed out." Yellow
    }
    catch {
        Write-Log "  DNS lookup for $HostName failed: $($_.Exception.GetBaseException().Message)" Yellow
    }

    return $false
}

function Wait-ForNetwork {
    param(
        [int]$TimeoutSeconds = 60
    )

    Write-Log "Waiting for usable network connectivity..."

    $deadline = (Get-Date).AddSeconds($TimeoutSeconds)

    while ((Get-Date) -lt $deadline) {

        if (Test-ActiveNetwork) {
            Write-Log "Network connectivity is available." Green
            return $true
        }

        Start-Sleep -Seconds 3
    }

    Write-Log "Network connectivity was not detected within $TimeoutSeconds seconds." Yellow

    return $false
}

# ============================================================
# VIRTIO FROM MEDIA
# ============================================================

function Install-VirtIODriversFromMedia {

    Write-Log "Searching CD/DVD drives for VirtIO installation media..."

    $cdroms = @(
        Get-CimInstance Win32_CDROMDrive -ErrorAction SilentlyContinue
    )

    foreach ($cdrom in $cdroms) {

        $drive = $cdrom.Drive

        if (-not $drive) {
            continue
        }

        if (-not (Test-Path $drive)) {
            continue
        }

        Write-Log "Searching $drive for VirtIO drivers..."

        try {

            $msi = Get-ChildItem `
                -Path $drive `
                -Filter "virtio-win-gt-x64.msi" `
                -File `
                -Recurse `
                -ErrorAction SilentlyContinue |
                Select-Object -First 1

            if ($msi) {

                Write-Log "Found VirtIO Guest Tools MSI:"
                Write-Log "  $($msi.FullName)"

                $installLog = Join-Path `
                    $VirtIODirectory `
                    "virtio-media-install.log"

                $process = Start-Process `
                    -FilePath "msiexec.exe" `
                    -ArgumentList @(
                        "/i",
                        "`"$($msi.FullName)`"",
                        "/qn",
                        "/norestart",
                        "/L*v",
                        "`"$installLog`""
                    ) `
                    -Wait `
                    -PassThru

                Write-Log "VirtIO MSI exit code: $($process.ExitCode)"

                if ($process.ExitCode -notin @(0, 3010)) {
                    throw "VirtIO MSI installation failed with exit code $($process.ExitCode)."
                }

                Write-Log "VirtIO MSI installed successfully." Green

                if (Test-ActiveNetwork) {
                    return $true
                }

                if (Wait-ForNetwork -TimeoutSeconds 60) {
                    return $true
                }
            }

        }
        catch {
            Write-Log `
                "VirtIO MSI installation failed on $drive : $($_.Exception.Message)" `
                Yellow
        }

        Write-Log "Searching for NetKVM INF drivers..."

        try {

            $drivers = @(
                Get-ChildItem `
                    -Path $drive `
                    -Filter "*.inf" `
                    -File `
                    -Recurse `
                    -ErrorAction SilentlyContinue |
                    Where-Object {
                        $_.FullName -match "(?i)\\NetKVM\\"
                    }
            )

            foreach ($driver in $drivers) {

                Write-Log "Installing network driver:"
                Write-Log "  $($driver.FullName)"

                & pnputil.exe `
                    /add-driver `
                    "`"$($driver.FullName)`"" `
                    /install

                Write-Log "pnputil exit code: $LASTEXITCODE"
            }

            if (Wait-ForNetwork -TimeoutSeconds 60) {
                return $true
            }

        }
        catch {
            Write-Log `
                "INF driver installation failed: $($_.Exception.Message)" `
                Yellow
        }
    }

    return $false
}

# ============================================================
# HTTP REDIRECT
# ============================================================

function Get-RedirectDestination {

    param(
        [Parameter(Mandatory = $true)]
        [string]$Url
    )

    Write-Log "Resolving redirect:"
    Write-Log "  $Url"

    $handler = New-Object System.Net.Http.HttpClientHandler
    $handler.AllowAutoRedirect = $false

    $client = New-Object System.Net.Http.HttpClient($handler)

    try {

        $response = $client.GetAsync(
            $Url,
            [System.Net.Http.HttpCompletionOption]::ResponseHeadersRead
        ).GetAwaiter().GetResult()

        $statusCode = [int]$response.StatusCode

        Write-Log "HTTP status: $statusCode"

        if ($statusCode -in @(301, 302, 303, 307, 308)) {

            $location = $response.Headers.Location

            if (-not $location) {
                throw "Redirect response contained no Location header."
            }

            return $location.AbsoluteUri
        }

        throw "Expected an HTTP redirect but received HTTP $statusCode."
    }
    finally {
        $client.Dispose()
        $handler.Dispose()
    }
}

# ============================================================
# DOWNLOAD
# ============================================================

function Download-File {

    param(
        [Parameter(Mandatory = $true)]
        [string]$Url,

        [Parameter(Mandatory = $true)]
        [string]$Destination
    )

    Write-Log "Downloading:"
    Write-Log "  $Url"

    Write-Log "Destination:"
    Write-Log "  $Destination"

    Invoke-WebRequest `
        -Uri $Url `
        -OutFile $Destination `
        -UseBasicParsing

    if (-not (Test-Path $Destination)) {
        throw "Download failed: $Destination does not exist."
    }

    $size = (Get-Item $Destination).Length

    if ($size -le 0) {
        throw "Downloaded file is empty: $Destination"
    }

    Write-Log "Download completed: $size bytes." Green
}

# ============================================================
# CHECKSUM
# ============================================================

function Get-ExpectedSha256 {

    param(
        [Parameter(Mandatory = $true)]
        [string]$ChecksumText,

        [Parameter(Mandatory = $true)]
        [string]$FileName
    )

    $escapedName = [regex]::Escape($FileName)

    # Optional directory prefix in front of the file name,
    # e.g. "./", "virtio-win-0.1.285/" or "amd64\".
    $pathPrefix = '(?:[^\s*()]*[/\\])?'

    # Format:
    # HASH *filename   /   HASH  path/filename

    $match = [regex]::Match(
        $ChecksumText,
        "(?im)^\s*([0-9a-f]{64})\s+\*?$pathPrefix$escapedName\s*$"
    )

    if ($match.Success) {
        return $match.Groups[1].Value.ToLowerInvariant()
    }

    # Format:
    # SHA256 (filename) = HASH   /   SHA2-256(path/filename)= HASH

    $match = [regex]::Match(
        $ChecksumText,
        "(?im)^\s*SHA(?:2-)?256\s*\(\s*$pathPrefix$escapedName\s*\)\s*=\s*([0-9a-f]{64})\s*$"
    )

    if ($match.Success) {
        return $match.Groups[1].Value.ToLowerInvariant()
    }

    # Format:
    # filename HASH   /   path/filename: HASH

    $match = [regex]::Match(
        $ChecksumText,
        "(?im)^\s*$pathPrefix$escapedName\s*:?\s+([0-9a-f]{64})\s*$"
    )

    if ($match.Success) {
        return $match.Groups[1].Value.ToLowerInvariant()
    }

    Write-Log "Checksum file contents (no entry matched ${FileName}):" Yellow
    foreach ($line in ($ChecksumText -split "\r?\n")) {
        Write-Log "  $line"
    }

    throw "Could not find SHA-256 checksum for $FileName."
}

# ============================================================
# VIRTIO RELEASE SELECTION
# ============================================================

$VirtIOMirrorUrl =
    "https://raw.githubusercontent.com/propstat/server-templates/refs/heads/main/virtio-drivers-mirror"

function Get-VirtIOReleaseForOS {

    param(
        [Parameter(Mandatory = $true)]
        [string]$CompatibilityYaml,

        [Parameter(Mandatory = $true)]
        [string]$OsName
    )

    # Minimal parser for compatibilityVirtIOWin.yaml:
    #   top-level "key: value" lines are aliases (virtIOStable, ...)
    #   entries below "supportMatrix:" map Windows version -> release

    $aliases  = @{}
    $matrix   = [ordered]@{}
    $inMatrix = $false

    foreach ($rawLine in ($CompatibilityYaml -split "\r?\n")) {

        $line = ($rawLine -replace '\s+#.*$', '').TrimEnd()

        if (-not $line.Trim() -or $line.TrimStart().StartsWith("#")) {
            continue
        }

        if ($line -match '^([^\s-][^:]*):\s*(.*)$') {

            $key   = $Matches[1].Trim()
            $value = $Matches[2].Trim().Trim('"', "'")

            if ($key -eq "supportMatrix") {
                $inMatrix = $true
            }
            else {
                $inMatrix = $false
                $aliases[$key] = $value
            }

            continue
        }

        if ($inMatrix -and $line -match '^\s*(?:-\s+)?([^:]+?)\s*:\s*(.+?)\s*$') {
            $matrix[$Matches[1].Trim('"', "'")] = $Matches[2].Trim('"', "'")
        }
    }

    if ($matrix.Count -eq 0) {
        throw "compatibilityVirtIOWin.yaml contains no supportMatrix entries."
    }

    # Longest matching name wins, so e.g. "Windows Server 2012"
    # is preferred over a shorter, more generic entry.

    $osKey =
        $matrix.Keys |
            Sort-Object -Property Length -Descending |
            Where-Object { $OsName -match "(?i)\b$([regex]::Escape($_))\b" } |
            Select-Object -First 1

    if (-not $osKey) {
        throw "No VirtIO release listed for '$OsName' in compatibilityVirtIOWin.yaml."
    }

    $release = $matrix[$osKey]

    if ($aliases.ContainsKey($release)) {
        $release = $aliases[$release]
    }

    if ($release -notmatch '^virtio-win-\d+\.\d+\.\d+(-\d+)?$') {
        throw "Invalid VirtIO release '$release' for '$osKey' in compatibilityVirtIOWin.yaml."
    }

    return [pscustomobject]@{
        OsKey   = $osKey
        Release = $release
    }
}

# ============================================================
# ONLINE VIRTIO INSTALLATION
# ============================================================

function Install-VirtIOOnline {

    param(
        [Parameter(Mandatory = $true)]
        [string]$OsName
    )

    Write-Section "VirtIO Online Installation"

    $compatibilityFile =
        Join-Path $VirtIODirectory "compatibilityVirtIOWin.yaml"

    Download-File `
        -Url "$VirtIOMirrorUrl/compatibilityVirtIOWin.yaml" `
        -Destination $compatibilityFile

    $selection =
        Get-VirtIOReleaseForOS `
            -CompatibilityYaml (Get-Content -Path $compatibilityFile -Raw) `
            -OsName $OsName

    $virtioBaseUrl = "$VirtIOMirrorUrl/$($selection.Release)"

    Write-Log "Operating system:"
    Write-Log "  $OsName"
    Write-Log "Matched support matrix entry:"
    Write-Log "  $($selection.OsKey)"
    Write-Log "VirtIO release:"
    Write-Log "  $virtioBaseUrl" Green

    $checksumFile =
        Join-Path $VirtIODirectory "checksum"

    $msiFile =
        Join-Path $VirtIODirectory "virtio-win-gt-x64.msi"

    $guestToolsFile =
        Join-Path $VirtIODirectory "virtio-win-guest-tools.exe"

    $installLog =
        Join-Path $VirtIODirectory "virtio-online-install.log"

    Download-File `
        -Url "$virtioBaseUrl/checksum" `
        -Destination $checksumFile

    $checksumText =
        Get-Content `
            -Path $checksumFile `
            -Raw `
            -ErrorAction Stop

    Download-File `
        -Url "$virtioBaseUrl/virtio-win-gt-x64.msi" `
        -Destination $msiFile

    # A real MSI is an OLE compound file (D0 CF 11 E0 A1 B1 1A E1).
    # Anything else (e.g. an HTML page) is rejected here.

    $msiHeader =
        [System.IO.File]::ReadAllBytes($msiFile)[0..7] |
            ForEach-Object { $_.ToString("X2") }

    if (($msiHeader -join "") -ne "D0CF11E0A1B11AE1") {
        $preview = (Get-Content -Path $msiFile -TotalCount 5) -join " "
        throw "Downloaded file is not an MSI ($((Get-Item $msiFile).Length) bytes). Start of file: $preview"
    }

    # The VirtIO MSIs are not Authenticode-signed, so they are
    # verified against the SHA-256 list in the mirror folder.

    foreach ($file in @($msiFile, $guestToolsFile)) {

        if ($file -eq $guestToolsFile) {
            Download-File `
                -Url "$virtioBaseUrl/virtio-win-guest-tools.exe" `
                -Destination $guestToolsFile
        }

        $fileName = Split-Path -Path $file -Leaf

        Write-Log "Verifying $fileName SHA-256..."

        $expectedHash =
            Get-ExpectedSha256 `
                -ChecksumText $checksumText `
                -FileName $fileName

        $actualHash = (
            Get-FileHash `
                -Path $file `
                -Algorithm SHA256
        ).Hash.ToLowerInvariant()

        Write-Log "Expected SHA-256:"
        Write-Log "  $expectedHash"

        Write-Log "Actual SHA-256:"
        Write-Log "  $actualHash"

        if ($actualHash -ne $expectedHash) {
            throw "$fileName SHA-256 verification FAILED. Installation refused."
        }

        Write-Log "SHA-256 verification successful." Green
    }

    Write-Log "Installing VirtIO Guest Tools MSI..."

    $process = Start-Process `
        -FilePath "msiexec.exe" `
        -ArgumentList @(
            "/i",
            "`"$msiFile`"",
            "/qn",
            "/norestart",
            "/L*v",
            "`"$installLog`""
        ) `
        -Wait `
        -PassThru

    Write-Log "VirtIO MSI exit code: $($process.ExitCode)"

    if ($process.ExitCode -notin @(0, 3010)) {
        throw "VirtIO MSI installation failed with exit code $($process.ExitCode)."
    }

    Write-Log "VirtIO MSI installation completed." Green

    # The MSI above only contains the VirtIO drivers. The QEMU guest
    # agent (and SPICE agent) ship in the guest tools bundle, a WiX
    # Burn installer: /install /quiet /norestart /log <file>.
    # Components already installed by the MSI are skipped.

    $guestToolsLog =
        Join-Path $VirtIODirectory "virtio-guest-tools-install.log"

    Write-Log "Installing VirtIO Guest Tools (QEMU guest agent)..."

    $process = Start-Process `
        -FilePath $guestToolsFile `
        -ArgumentList @(
            "/install",
            "/quiet",
            "/norestart",
            "/log",
            "`"$guestToolsLog`""
        ) `
        -Wait `
        -PassThru

    Write-Log "VirtIO Guest Tools exit code: $($process.ExitCode)"

    if ($process.ExitCode -notin @(0, 1641, 3010)) {
        throw "VirtIO Guest Tools installation failed with exit code $($process.ExitCode). See $guestToolsLog"
    }

    $guestAgent =
        Get-Service -Name "QEMU-GA" -ErrorAction SilentlyContinue

    if (-not $guestAgent) {
        Write-Log "QEMU guest agent service not found after installation. See $guestToolsLog" Yellow
    }
    elseif ($guestAgent.Status -ne "Running") {
        # The agent only runs when the VM has the guest agent
        # channel enabled (Proxmox: Options > QEMU Guest Agent).
        Write-Log "QEMU guest agent installed but $($guestAgent.Status). Enable the guest agent in the VM options." Yellow
    }
    else {
        Write-Log "QEMU guest agent installed and running." Green
    }

    return $true
}

# ============================================================
# 1. VIRTIO / NETWORK BOOTSTRAP
# ============================================================

Write-Section "VirtIO / Network Bootstrap"

# VirtIO drivers are only installed on QEMU/KVM guests.

$computerInfo =
    Get-ComputerInfo `
        -Property CsManufacturer, CsModel, OsName

$IsQemuVM =
    [string]$computerInfo.CsManufacturer -match '(?i)\bQEMU\b'

Write-Log "Manufacturer: $($computerInfo.CsManufacturer)"
Write-Log "Model:        $($computerInfo.CsModel)"
Write-Log "OS:           $($computerInfo.OsName)"

if ($IsQemuVM) {
    Write-Log "QEMU virtual machine detected. VirtIO drivers will be installed." Green
}
else {
    Write-Log "Not a QEMU virtual machine. VirtIO installation skipped." Yellow
}

if (Test-ActiveNetwork) {

    Write-Log "Usable network connection already exists." Green

}
elseif ($IsQemuVM) {

    Write-Log "No usable Internet network detected." Yellow

    $mediaNetwork =
        Install-VirtIODriversFromMedia

    if (-not $mediaNetwork) {

        Write-Host ""
        Write-Host "No usable network connection was established." `
            -ForegroundColor Yellow

        Write-Host ""
        Read-Host "Insert or mount the VirtIO ISO, then press ENTER"

        Write-Log "Rescanning for VirtIO media..."

        if (-not (Install-VirtIODriversFromMedia)) {
            throw "Unable to establish a usable network connection using VirtIO media."
        }
    }
}

if (-not (Test-ActiveNetwork)) {
    throw "Network is still unavailable after VirtIO bootstrap."
}

# Basic connectivity works (IP level). Name resolution is tested
# separately so a DNS problem is reported as such.

if (-not (Test-DnsResolution)) {

    $dnsServers = @(
        Get-DnsClientServerAddress -AddressFamily IPv4 -ErrorAction SilentlyContinue |
            Where-Object { $_.ServerAddresses } |
            ForEach-Object { "$($_.InterfaceAlias): $($_.ServerAddresses -join ', ')" }
    )

    Write-Log "Configured DNS servers:" Yellow
    foreach ($entry in $dnsServers) {
        Write-Log "  $entry" Yellow
    }

    throw "Internet is reachable ($NetworkTestHost) but DNS resolution of $DnsTestHost failed. Check the DNS server configuration."
}

Write-Log "Network bootstrap complete." Green

if ($IsQemuVM) {
    Install-VirtIOOnline -OsName $computerInfo.OsName | Out-Null
}

# ============================================================
# 2. COMPUTER NAME
# ============================================================

Write-Section "Computer Name"

$currentComputerName = $env:COMPUTERNAME

do {

    $computerName =
        Read-Host "Computer name [$currentComputerName]"

    if ([string]::IsNullOrWhiteSpace($computerName)) {
        $computerName = $currentComputerName
    }

    if (
        $computerName.Length -gt 15 -or
        $computerName -notmatch "^[A-Za-z0-9][A-Za-z0-9-]*[A-Za-z0-9]$"
    ) {

        Write-Log `
            "Invalid computer name. Maximum 15 characters; letters, numbers and hyphens only." `
            Yellow

        $computerName = $null
    }

}
while (-not $computerName)

if ($computerName -ne $currentComputerName) {

    Rename-Computer `
        -NewName $computerName `
        -Force

    Write-Log `
        "Computer will be renamed to $computerName." `
        Green

}
else {

    Write-Log "Computer name remains $currentComputerName."
}

# ============================================================
# 3. TIME ZONE
# ============================================================

Write-Section "Time Zone"

$timeZones = @(
    Get-TimeZone -ListAvailable |
        Sort-Object Id
)

$currentTimeZone = (Get-TimeZone).Id

Write-Log "Current time zone: $currentTimeZone"

Write-Host ""
Write-Host "Time zone input - any of the following is accepted:" -ForegroundColor Cyan
Write-Host "  IANA name        Europe/Rome, America/New_York, Etc/UTC"
Write-Host "  Windows ID       W. Europe Standard Time, Eastern Standard Time, UTC"
Write-Host "  Part of a name   Rome, Berlin, Pacific, UTC+01"
Write-Host "  (empty)          keep current: $currentTimeZone"
Write-Host "A partial name that matches several time zones shows a numbered list to pick from." -ForegroundColor DarkGray
Write-Host ""

$timeZoneSearch =
    Read-Host `
        "Time zone"

if (-not [string]::IsNullOrWhiteSpace($timeZoneSearch)) {

    $timeZoneSearch = $timeZoneSearch.Trim()

    # Windows uses its own time zone IDs ("W. Europe Standard Time").
    # IANA names such as "Europe/Rome" are converted first.

    $windowsTimeZoneId = $null

    if ($timeZoneSearch -match '/') {

        if ([System.TimeZoneInfo]::TryConvertIanaIdToWindowsId(
                $timeZoneSearch,
                [ref]$windowsTimeZoneId)) {

            Write-Log "IANA time zone $timeZoneSearch = Windows ID $windowsTimeZoneId"
        }
        else {
            # Unknown to the converter: search for the city part
            # ("Europe/Rome" -> "Rome") in the display names.
            $timeZoneSearch = ($timeZoneSearch -split '/')[-1] -replace '_', ' '
        }
    }

    if ($windowsTimeZoneId) {

        $timeZoneMatches = @(
            $timeZones |
                Where-Object { $_.Id -eq $windowsTimeZoneId }
        )
    }
    else {

        $timeZoneMatches = @(
            $timeZones |
                Where-Object {
                    $_.Id -like "*$timeZoneSearch*" -or
                    $_.DisplayName -like "*$timeZoneSearch*"
                }
        )
    }

    if ($timeZoneMatches.Count -eq 0) {
        throw "No time zone matched '$timeZoneSearch'."
    }

    if ($timeZoneMatches.Count -eq 1) {

        $selectedTimeZone = $timeZoneMatches[0]

    }
    else {

        Write-Host ""

        for ($i = 0; $i -lt $timeZoneMatches.Count; $i++) {

            Write-Host `
                "[$($i + 1)] $($timeZoneMatches[$i].Id) - $($timeZoneMatches[$i].DisplayName)"
        }

        do {

            $selection =
                Read-Host "Select time zone"

            $number = 0

            $valid =
                [int]::TryParse(
                    $selection,
                    [ref]$number
                )

        }
        while (
            -not $valid -or
            $number -lt 1 -or
            $number -gt $timeZoneMatches.Count
        )

        $selectedTimeZone =
            $timeZoneMatches[$number - 1]
    }

    Set-TimeZone `
        -Id $selectedTimeZone.Id

    Write-Log `
        "Time zone set to $($selectedTimeZone.Id)." `
        Green

}
else {

    Write-Log "Time zone unchanged."
}

# ============================================================
# 4. WINDOWS SERVER EDITION
# ============================================================

Write-Section "Windows Server Edition"

Write-Log "Reading available target editions from DISM..."

$dismOutput =
    & dism.exe /online /Get-TargetEditions 2>&1

if ($LASTEXITCODE -ne 0) {
    throw "DISM /Get-TargetEditions failed with exit code $LASTEXITCODE."
}

$editionKeys = @{
    "ServerStandard" =
        "TVRH6-WHNXV-R9WG3-9XRFY-MY832"

    "ServerDatacenter" =
        "D764K-2NDRG-47T6Q-P8T8W-YP6DF"
}

$targetEditions = @(
    $dismOutput |
        ForEach-Object {

            if (
                $_ -match `
                "Target Edition\s*:\s*(.+?)\s*$"
            ) {
                $matches[1].Trim()
            }
        } |
        Where-Object {
            $_ -and
            $editionKeys.ContainsKey($_)
        } |
        Select-Object -Unique
)

if ($targetEditions.Count -eq 0) {
    throw "No supported ServerStandard or ServerDatacenter target edition was found."
}

for ($i = 0; $i -lt $targetEditions.Count; $i++) {
    Write-Host "[$($i + 1)] $($targetEditions[$i])"
}

do {

    $selection =
        Read-Host "Select target edition"

    $number = 0

    $valid =
        [int]::TryParse(
            $selection,
            [ref]$number
        )

}
while (
    -not $valid -or
    $number -lt 1 -or
    $number -gt $targetEditions.Count
)

$edition =
    $targetEditions[$number - 1]

$editionKey =
    $editionKeys[$edition]

Write-Log "Selected edition: $edition" Green

# ============================================================
# 5. TEMPLATE ID
# ============================================================

Write-Section "Template ID"

do {

    $templateID =
        Read-Host "Enter template ID (01-99)"

    $validTemplateID = (
        $templateID -match "^\d{1,2}$" -and
        [int]$templateID -ge 1 -and
        [int]$templateID -le 99
    )

    if (-not $validTemplateID) {

        Write-Log `
            "Template ID must be a number from 01 to 99." `
            Yellow
    }

}
while (-not $validTemplateID)

$templateID =
    ([int]$templateID).ToString("00")

Write-Log "Template ID: $templateID" Green

# ============================================================
# 6. NETWORK CONFIGURATION
# ============================================================

Write-Section "Network Configuration"

$adapter =
    Get-NetAdapter |
        Where-Object {
            $_.HardwareInterface -eq $true
        } |
        Sort-Object ifIndex |
        Select-Object -First 1

if (-not $adapter) {
    throw "No physical network adapter was found."
}

Write-Log "Using network adapter:"
Write-Log "  Name:      $($adapter.Name)"
Write-Log "  Interface: $($adapter.ifIndex)"
Write-Log "  MAC:       $($adapter.MacAddress)"

$dhcpIPv4 =
    Get-NetIPAddress `
        -InterfaceIndex $adapter.ifIndex `
        -AddressFamily IPv4 `
        -ErrorAction SilentlyContinue |
        Where-Object {
            $_.PrefixOrigin -eq "Dhcp" -and
            $_.IPAddress -notlike "169.254.*"
        } |
        Select-Object -First 1

if ($dhcpIPv4) {

    Write-Log `
        "DHCP IPv4 address detected: $($dhcpIPv4.IPAddress)"

    $octets =
        $dhcpIPv4.IPAddress.Split(".")

    if ($octets.Count -ne 4) {
        throw "Unexpected IPv4 address format: $($dhcpIPv4.IPAddress)"
    }

    $staticIP =
        "$($octets[0]).$($octets[1]).$($octets[2]).$templateID"

    $defaultRoute =
        Get-NetRoute `
            -InterfaceIndex $adapter.ifIndex `
            -AddressFamily IPv4 `
            -DestinationPrefix "0.0.0.0/0" `
            -ErrorAction SilentlyContinue |
            Sort-Object RouteMetric |
            Select-Object -First 1

    if (-not $defaultRoute) {
        throw "No DHCP default gateway was found."
    }

    $gateway =
        $defaultRoute.NextHop

    $prefixLength = 24

    $dnsServers =
        @("1.1.1.1")

    Write-Host ""
    Write-Host "DHCP-derived static configuration:"
    Write-Host "  IP:      $staticIP/$prefixLength"
    Write-Host "  Gateway: $gateway"
    Write-Host "  DNS:     $($dnsServers -join ', ')"

    $confirm =
        Read-Host "Apply this configuration? [Y/n]"

    if (
        -not [string]::IsNullOrWhiteSpace($confirm) -and
        $confirm -notmatch "^[Yy]"
    ) {

        $staticIP =
            Read-Host "IPv4 address"

        $prefixLength =
            24

        $gateway =
            Read-Host "Default gateway"

        $dnsInput =
            Read-Host "DNS server(s), comma separated"

        $dnsServers = @(
            $dnsInput.Split(",") |
                ForEach-Object {
                    $_.Trim()
                } |
                Where-Object {
                    $_
                }
        )
    }

}
else {

    Write-Log "No DHCP IPv4 address detected."

    $staticIP =
        Read-Host "IPv4 address"

    $subnetMask =
        Read-Host "Subnet mask"

    $gateway =
        Read-Host "Default gateway"

    $dnsInput =
        Read-Host "DNS server(s), comma separated"

    $dnsServers = @(
        $dnsInput.Split(",") |
            ForEach-Object {
                $_.Trim()
            } |
            Where-Object {
                $_
            }
    )

    function Convert-SubnetMaskToPrefixLength {

        param(
            [Parameter(Mandatory = $true)]
            [string]$Mask
        )

        $parts =
            $Mask.Split(".")

        if ($parts.Count -ne 4) {
            throw "Invalid subnet mask: $Mask"
        }

        $binary = ""

        foreach ($part in $parts) {

            $octet = 0

            if (
                -not [int]::TryParse(
                    $part,
                    [ref]$octet
                ) -or
                $octet -lt 0 -or
                $octet -gt 255
            ) {
                throw "Invalid subnet mask: $Mask"
            }

            $binary +=
                [Convert]::ToString(
                    $octet,
                    2
                ).PadLeft(8, "0")
        }

        if ($binary -notmatch "^1*0*$") {
            throw "Subnet mask is not contiguous: $Mask"
        }

        return (
            $binary.ToCharArray() |
                Where-Object {
                    $_ -eq "1"
                }
        ).Count
    }

    $prefixLength =
        Convert-SubnetMaskToPrefixLength `
            -Mask $subnetMask
}

if (
    $prefixLength -lt 1 -or
    $prefixLength -gt 32
) {
    throw "Invalid prefix length: $prefixLength."
}

Write-Log "Applying static IPv4 configuration..."

Get-NetIPAddress `
    -InterfaceIndex $adapter.ifIndex `
    -AddressFamily IPv4 `
    -ErrorAction SilentlyContinue |
    Remove-NetIPAddress `
        -Confirm:$false `
        -ErrorAction SilentlyContinue

Get-NetRoute `
    -InterfaceIndex $adapter.ifIndex `
    -AddressFamily IPv4 `
    -DestinationPrefix "0.0.0.0/0" `
    -ErrorAction SilentlyContinue |
    Remove-NetRoute `
        -Confirm:$false `
        -ErrorAction SilentlyContinue

Set-NetIPInterface `
    -InterfaceIndex $adapter.ifIndex `
    -AddressFamily IPv4 `
    -Dhcp Disabled

New-NetIPAddress `
    -InterfaceIndex $adapter.ifIndex `
    -IPAddress $staticIP `
    -PrefixLength $prefixLength `
    -DefaultGateway $gateway

Set-DnsClientServerAddress `
    -InterfaceIndex $adapter.ifIndex `
    -ServerAddresses $dnsServers

Write-Log "Static network configuration applied." Green

# ============================================================
# 7. ENABLE RDP
# ============================================================

Write-Section "Remote Desktop"

Set-ItemProperty `
    -Path "HKLM:\System\CurrentControlSet\Control\Terminal Server" `
    -Name "fDenyTSConnections" `
    -Value 0

Enable-NetFirewallRule `
    -DisplayGroup "Remote Desktop"

Write-Log "Remote Desktop enabled." Green

# ============================================================
# 8. GOOGLE CHROME
# ============================================================

Write-Section "Google Chrome"

if (-not (Get-Command winget.exe -ErrorAction SilentlyContinue)) {
    throw "winget.exe was not found."
}

Write-Log "Installing Google Chrome..."

& winget.exe install `
    --id Google.Chrome `
    --exact `
    --silent `
    --accept-package-agreements `
    --accept-source-agreements

Write-Log "winget Chrome exit code: $LASTEXITCODE"

if ($LASTEXITCODE -ne 0) {
    throw "Google Chrome installation failed with exit code $LASTEXITCODE."
}

Write-Log "Google Chrome installed." Green

# ============================================================
# 9. 7-ZIP
# ============================================================

Write-Section "7-Zip"

Write-Log "Installing 7-Zip..."

& winget.exe install `
    --id 7zip.7zip `
    --exact `
    --silent `
    --accept-package-agreements `
    --accept-source-agreements

Write-Log "winget 7-Zip exit code: $LASTEXITCODE"

if ($LASTEXITCODE -ne 0) {
    throw "7-Zip installation failed with exit code $LASTEXITCODE."
}

Write-Log "7-Zip installed." Green

# ============================================================
# 10. INITIAL WINDOWS UPDATE
# ============================================================

Write-Section "Initial Windows Update"

Write-Log "Creating Windows Update session..."

$updateSession =
    New-Object -ComObject Microsoft.Update.Session

$updateSearcher =
    $updateSession.CreateUpdateSearcher()

Write-Log "Searching for applicable updates..."

$searchResult =
    $updateSearcher.Search(
        "IsInstalled=0 and IsHidden=0 and Type='Software'"
    )

$updates = @(
    $searchResult.Updates
)

Write-Log "Updates found: $($updates.Count)"

if ($updates.Count -gt 0) {

    $updatesToInstall =
        New-Object -ComObject Microsoft.Update.UpdateColl

    foreach ($update in $updates) {

        try {

            if (-not $update.EulaAccepted) {
                $update.AcceptEula()
            }

        }
        catch {}

        [void]$updatesToInstall.Add($update)
    }

    Write-Log "Downloading updates..."

    $downloader =
        $updateSession.CreateUpdateDownloader()

    $downloader.Updates =
        $updatesToInstall

    $downloadResult =
        $downloader.Download()

    Write-Log `
        "Windows Update download result: $($downloadResult.ResultCode)"

    Write-Log "Installing updates..."

    $installer =
        $updateSession.CreateUpdateInstaller()

    $installer.Updates =
        $updatesToInstall

    $installResult =
        $installer.Install()

    Write-Log `
        "Windows Update installation result: $($installResult.ResultCode)"

    Write-Log `
        "Windows Update reboot required: $($installResult.RebootRequired)"
}
else {

    Write-Log "No applicable Windows Updates found."
}

# ============================================================
# 11. POST-REBOOT WINDOWS UPDATE
# ============================================================

Write-Section "Post-Reboot Windows Update"

$postRebootScript =
    Join-Path `
        $InstallDirectory `
        "Server2025-PostRebootUpdate.ps1"

$postRebootLog =
    Join-Path `
        $InstallDirectory `
        "Server2025-PostRebootUpdate.log"

$taskName =
    "Server2025-PostRebootUpdate"

$postRebootContent = @'
$ErrorActionPreference = "Continue"

$InstallDirectory = "C:\propstatInstallScript"
$LogFile = Join-Path $InstallDirectory "Server2025-PostRebootUpdate.log"

New-Item `
    -ItemType Directory `
    -Path $InstallDirectory `
    -Force `
    -ErrorAction SilentlyContinue |
    Out-Null

function Write-Log {
    param(
        [string]$Message
    )

    $timestamp =
        Get-Date -Format "yyyy-MM-dd HH:mm:ss"

    Add-Content `
        -Path $LogFile `
        -Value "[$timestamp] $Message" `
        -ErrorAction SilentlyContinue
}

Write-Log "============================================================"
Write-Log "Post-reboot Windows Update task started."
Write-Log "============================================================"

try {

    Write-Log "Waiting 30 seconds for Windows services."

    Start-Sleep -Seconds 30

    Write-Log "Creating Windows Update session."

    $session =
        New-Object -ComObject Microsoft.Update.Session

    $searcher =
        $session.CreateUpdateSearcher()

    Write-Log "Searching for remaining updates."

    $result =
        $searcher.Search(
            "IsInstalled=0 and IsHidden=0 and Type='Software'"
        )

    $updates = @(
        $result.Updates
    )

    Write-Log "Updates found: $($updates.Count)"

    if ($updates.Count -gt 0) {

        $collection =
               New-Object -ComObject Microsoft.Update.UpdateColl

        foreach ($update in $updates) {

            try {

                if (-not $update.EulaAccepted) {
                    $update.AcceptEula()
                }

            }
            catch {}

            [void]$collection.Add($update)
        }

        Write-Log "Downloading updates."

        $downloader =
            $session.CreateUpdateDownloader()

        $downloader.Updates =
            $collection

        $downloadResult =
            $downloader.Download()

        Write-Log `
            "Download result: $($downloadResult.ResultCode)"

        Write-Log "Installing updates."

        $installer =
            $session.CreateUpdateInstaller()

        $installer.Updates =
            $collection

        $installResult =
            $installer.Install()

        Write-Log `
            "Installation result: $($installResult.ResultCode)"

        Write-Log `
            "Reboot required: $($installResult.RebootRequired)"

    }
    else {

        Write-Log "No additional updates found."
    }

}
catch {

    Write-Log "ERROR: $($_.Exception.Message)"
    Write-Log ($_ | Out-String)

}
finally {

    Write-Log "Removing scheduled task."

    try {

        Unregister-ScheduledTask `
            -TaskName "Server2025-PostRebootUpdate" `
            -Confirm:$false `
            -ErrorAction SilentlyContinue

    }
    catch {}

    Write-Log "Post-reboot update task completed."
}
'@

Set-Content `
    -Path $postRebootScript `
    -Value $postRebootContent `
    -Encoding UTF8

$action =
    New-ScheduledTaskAction `
        -Execute (Join-Path $env:ProgramFiles "PowerShell\7\pwsh.exe") `
        -Argument `
            "-NoProfile -ExecutionPolicy Bypass -File `"$postRebootScript`""

$trigger =
    New-ScheduledTaskTrigger `
        -AtStartup

$principal =
    New-ScheduledTaskPrincipal `
        -UserId "SYSTEM" `
        -LogonType ServiceAccount `
        -RunLevel Highest

$settings =
    New-ScheduledTaskSettingsSet `
        -StartWhenAvailable

Register-ScheduledTask `
    -TaskName $taskName `
    -Action $action `
    -Trigger $trigger `
    -Principal $principal `
    -Settings $settings `
    -Force |
    Out-Null

Write-Log `
    "Post-reboot Windows Update task registered." `
    Green

# ============================================================
# 12. EDITION CONVERSION
# ============================================================

Write-Section "Windows Server Edition Conversion"

Write-Log "Target edition:"
Write-Log "  $edition"

Write-Log "Running DISM edition conversion..."

& dism.exe `
    /online `
    "/Set-Edition:$edition" `
    "/ProductKey:$editionKey" `
    /AcceptEula

Write-Log "DISM exit code: $LASTEXITCODE"

if ($LASTEXITCODE -ne 0) {
    throw "DISM edition conversion failed with exit code $LASTEXITCODE."
}

Write-Log "Edition conversion completed successfully." Green

# ============================================================
# 12a. ON-DEMAND SERVICES
# ============================================================

Write-Section "On-Demand Services"

# These services start, do their work and stop by design.
# With start type Automatic, Server Manager reports them as
# failed services. Manual keeps them working (trigger start,
# scheduled tasks, Windows Update) without the false alerts.

$onDemandServices = @(
    Get-Service -Name "GoogleUpdater*", "InventorySvc" -ErrorAction SilentlyContinue
    Get-Service -ErrorAction SilentlyContinue |
        Where-Object DisplayName -like "Spice Agent*"
)

foreach ($service in $onDemandServices) {

    Set-Service `
        -Name $service.Name `
        -StartupType Manual

    Write-Log "Start type set to Manual: $($service.Name) ($($service.DisplayName))"
}

# Clipboard User Service is created per logon session from the
# cbdhsvc template. Setting the template to Manual (3) applies to
# every new session.

Set-ItemProperty `
    -Path "HKLM:\SYSTEM\CurrentControlSet\Services\cbdhsvc" `
    -Name Start `
    -Value 3

Write-Log "Start type set to Manual: cbdhsvc (Clipboard User Service template)"

# Windows Modules Installer (TrustedInstaller) is not changed: it is
# Manual by default and Windows only sets it to Automatic while a
# reboot is pending. The final reboot below resets it.

# Google Updater creates a new, versioned service set to Automatic
# every time it updates itself. A startup task sets any
# GoogleUpdater* service back to Manual after every reboot.

$googleUpdaterScript =
    Join-Path $InstallDirectory "Set-GoogleUpdaterManual.ps1"

$googleUpdaterContent = @'
$LogFile = "C:\propstatInstallScript\Set-GoogleUpdaterManual.log"

$services = @(
    Get-Service -Name "GoogleUpdater*" -ErrorAction SilentlyContinue |
        Where-Object StartType -ne "Manual"
)

foreach ($service in $services) {

    try {
        Set-Service -Name $service.Name -StartupType Manual -ErrorAction Stop
        $result = "set to Manual (was $($service.StartType))"
    }
    catch {
        $result = "FAILED: $($_.Exception.Message)"
    }

    Add-Content `
        -Path $LogFile `
        -Value "[$(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')] $($service.Name): $result"
}
'@

Set-Content `
    -Path $googleUpdaterScript `
    -Value $googleUpdaterContent `
    -Encoding UTF8

$googleUpdaterAction =
    New-ScheduledTaskAction `
        -Execute (Join-Path $env:ProgramFiles "PowerShell\7\pwsh.exe") `
        -Argument `
            "-NoProfile -ExecutionPolicy Bypass -File `"$googleUpdaterScript`""

$googleUpdaterTrigger =
    New-ScheduledTaskTrigger `
        -AtStartup

# Give Google Updater time to register a new service after boot.
$googleUpdaterTrigger.Delay = "PT2M"

$googleUpdaterPrincipal =
    New-ScheduledTaskPrincipal `
        -UserId "SYSTEM" `
        -LogonType ServiceAccount `
        -RunLevel Highest

$googleUpdaterSettings =
    New-ScheduledTaskSettingsSet `
        -StartWhenAvailable `
        -ExecutionTimeLimit (New-TimeSpan -Minutes 5)

Register-ScheduledTask `
    -TaskName "Propstat-GoogleUpdaterManual" `
    -Description "Sets Google Updater services to Manual start after every reboot." `
    -Action $googleUpdaterAction `
    -Trigger $googleUpdaterTrigger `
    -Principal $googleUpdaterPrincipal `
    -Settings $googleUpdaterSettings `
    -Force |
    Out-Null

Write-Log "Startup task registered: Propstat-GoogleUpdaterManual" Green
Write-Log "  Script: $googleUpdaterScript"
Write-Log "  Log:    C:\propstatInstallScript\Set-GoogleUpdaterManual.log"

# ============================================================
# 13. FINAL REBOOT
# ============================================================

Write-Section "Reboot"

Write-Log "Provisioning is complete." Green
Write-Log ""
Write-Log "The system will reboot in 15 seconds."
Write-Log ""
Write-Log "The post-reboot Windows Update task will:"
Write-Log "  1. Wait for Windows to initialize."
Write-Log "  2. Perform one additional Windows Update pass."
Write-Log "  3. Write its results to:"
Write-Log "     $postRebootLog"
Write-Log "  4. Remove itself."
Write-Log ""

for ($i = 15; $i -gt 0; $i--) {

    Write-Host `
        "`rRebooting in $i seconds... " `
        -NoNewline

    Start-Sleep -Seconds 1
}

Write-Host ""
Write-Log "Rebooting now..." Yellow

try {
    Stop-Transcript | Out-Null
}
catch {}

try {

    Restart-Computer -Force

}
catch {

    Write-Host ""
    Write-Host "============================================================" `
        -ForegroundColor Red
    Write-Host "REBOOT FAILED" `
        -ForegroundColor Red
    Write-Host "============================================================" `
        -ForegroundColor Red
    Write-Host ""
    Write-Host $_.Exception.Message `
        -ForegroundColor Red
    Write-Host ""
    Write-Host "The PowerShell window will remain open." `
        -ForegroundColor Yellow

    Wait-Forever
}

# If Restart-Computer unexpectedly returns, do not close.
Wait-Forever