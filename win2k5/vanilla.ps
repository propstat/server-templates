#requires -RunAsAdministrator

# ============================================================
# POWERSHELL 7 BOOTSTRAP
# Installs the latest PowerShell 7 if missing and re-runs
# this script under pwsh. Everything below runs on 7+.
# ============================================================

if ($PSVersionTable.PSVersion.Major -lt 7) {

    $pwsh = Join-Path $env:ProgramFiles "PowerShell\7\pwsh.exe"

    if (-not (Test-Path $pwsh)) {
        Write-Host "PowerShell 7 not found. Installing latest release..."
        [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
        Invoke-Expression "& { $(Invoke-RestMethod -UseBasicParsing https://aka.ms/install-powershell.ps1) } -UseMSI -Quiet"
    }

    if (-not (Test-Path $pwsh)) {
        throw "PowerShell 7 installation failed: $pwsh not found."
    }

    Write-Host "Relaunching under PowerShell 7..."
    & $pwsh -NoProfile -ExecutionPolicy Bypass -File $PSCommandPath @args
    exit $LASTEXITCODE
}

$ErrorActionPreference = "Stop"

# ============================================================
# Propstat
# Windows Server 2025 Vanilla Provisioning
# ============================================================

$InstallDirectory = "C:\propstatInstallScript"
$VirtIODirectory   = Join-Path $InstallDirectory "VirtIO"
$LogFile           = Join-Path $InstallDirectory "vanilla-provisioning.log"

New-Item -ItemType Directory -Path $InstallDirectory -Force | Out-Null
New-Item -ItemType Directory -Path $VirtIODirectory -Force | Out-Null

# ============================================================
# LOGGING
# ============================================================

try {
    Start-Transcript -Path $LogFile -Append | Out-Null
}
catch {
    # Transcript failure must never prevent the provisioning
    # script from continuing.
}

function Write-Log {
    param(
        [Parameter(Mandatory = $true)]
        [AllowEmptyString()]
        [string]$Message,

        [ConsoleColor]$Color = [ConsoleColor]::Gray
    )

    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"

    try {
        Add-Content `
            -Path $LogFile `
            -Value "[$timestamp] $Message" `
            -ErrorAction SilentlyContinue
    }
    catch {}

    Write-Host $Message -ForegroundColor $Color
}

function Write-Section {
    param(
        [Parameter(Mandatory = $true)]
        [string]$Text
    )

    Write-Log ""
    Write-Log "============================================================" Cyan
    Write-Log $Text Cyan
    Write-Log "============================================================" Cyan
}

function Wait-Forever {
    Write-Host ""
    Write-Host "============================================================" -ForegroundColor Yellow
    Write-Host "The provisioning script has stopped." -ForegroundColor Yellow
    Write-Host ""
    Write-Host "The PowerShell window will remain open." -ForegroundColor Yellow
    Write-Host "Log file:" -ForegroundColor Cyan
    Write-Host "  $LogFile" -ForegroundColor Cyan
    Write-Host ""
    Write-Host "Close this window manually when finished." -ForegroundColor Yellow
    Write-Host "============================================================" -ForegroundColor Yellow
    Write-Host ""

    while ($true) {
        Start-Sleep -Seconds 60
    }
}

# ============================================================
# GLOBAL ERROR HANDLER
# ============================================================

trap {
    Write-Host ""
    Write-Host "============================================================" -ForegroundColor Red
    Write-Host "PROVISIONING SCRIPT FAILED" -ForegroundColor Red
    Write-Host "============================================================" -ForegroundColor Red
    Write-Host ""

    try {
        Add-Content `
            -Path $LogFile `
            -Value ""
        Add-Content `
            -Path $LogFile `
            -Value "============================================================"
        Add-Content `
            -Path $LogFile `
            -Value "PROVISIONING SCRIPT FAILED"
        Add-Content `
            -Path $LogFile `
            -Value "============================================================"
        Add-Content `
            -Path $LogFile `
            -Value "Time: $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')"
        Add-Content `
            -Path $LogFile `
            -Value "Error: $($_.Exception.Message)"
        Add-Content `
            -Path $LogFile `
            -Value "Location: $($_.InvocationInfo.PositionMessage)"
        Add-Content `
            -Path $LogFile `
            -Value ($_ | Out-String)
    }
    catch {}

    Write-Host "Error:" -ForegroundColor Yellow
    Write-Host $_.Exception.Message -ForegroundColor Red
    Write-Host ""
    Write-Host "Location:" -ForegroundColor Yellow
    Write-Host $_.InvocationInfo.PositionMessage -ForegroundColor Red
    Write-Host ""
    Write-Host "Full error:" -ForegroundColor Yellow
    Write-Host ($_ | Out-String) -ForegroundColor Red
    Write-Host ""
    Write-Host "Log file:" -ForegroundColor Cyan
    Write-Host $LogFile -ForegroundColor Cyan

    try {
        Stop-Transcript | Out-Null
    }
    catch {}

    Wait-Forever
}

Write-Log "============================================================" Cyan
Write-Log "Propstat Windows Server 2025 Vanilla Provisioning" Cyan
Write-Log "Started: $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')" Cyan
Write-Log "Install directory: $InstallDirectory" Cyan
Write-Log "Log file: $LogFile" Cyan
Write-Log "============================================================" Cyan

# ============================================================
# NETWORK TEST
# ============================================================

function Test-ActiveNetwork {

    $adapters = @(
        Get-NetAdapter -ErrorAction SilentlyContinue |
            Where-Object {
                $_.Status -eq "Up" -and
                $_.HardwareInterface -eq $true
            }
    )

    foreach ($adapter in $adapters) {

        $ipAddresses = @(
            Get-NetIPAddress `
                -InterfaceIndex $adapter.ifIndex `
                -AddressFamily IPv4 `
                -ErrorAction SilentlyContinue |
                Where-Object {
                    $_.IPAddress -notlike "169.254.*" -and
                    $_.IPAddress -notlike "127.*"
                }
        )

        if ($ipAddresses.Count -eq 0) {
            continue
        }

        try {
            if (
                Test-NetConnection `
                    -ComputerName "fedorapeople.org" `
                    -Port 443 `
                    -InformationLevel Quiet `
                    -WarningAction SilentlyContinue
            ) {
                return $true
            }
        }
        catch {}
    }

    return $false
}

function Wait-ForNetwork {
    param(
        [int]$TimeoutSeconds = 60
    )

    Write-Log "Waiting for usable network connectivity..."

    $deadline = (Get-Date).AddSeconds($TimeoutSeconds)

    while ((Get-Date) -lt $deadline) {

        if (Test-ActiveNetwork) {
            Write-Log "Network connectivity is available." Green
            return $true
        }

        Start-Sleep -Seconds 3
    }

    Write-Log "Network connectivity was not detected within $TimeoutSeconds seconds." Yellow

    return $false
}

# ============================================================
# VIRTIO FROM MEDIA
# ============================================================

function Install-VirtIODriversFromMedia {

    Write-Log "Searching CD/DVD drives for VirtIO installation media..."

    $cdroms = @(
        Get-CimInstance Win32_CDROMDrive -ErrorAction SilentlyContinue
    )

    foreach ($cdrom in $cdroms) {

        $drive = $cdrom.Drive

        if (-not $drive) {
            continue
        }

        if (-not (Test-Path $drive)) {
            continue
        }

        Write-Log "Searching $drive for VirtIO drivers..."

        try {

            $msi = Get-ChildItem `
                -Path $drive `
                -Filter "virtio-win-gt-x64.msi" `
                -File `
                -Recurse `
                -ErrorAction SilentlyContinue |
                Select-Object -First 1

            if ($msi) {

                Write-Log "Found VirtIO Guest Tools MSI:"
                Write-Log "  $($msi.FullName)"

                $installLog = Join-Path `
                    $VirtIODirectory `
                    "virtio-media-install.log"

                $process = Start-Process `
                    -FilePath "msiexec.exe" `
                    -ArgumentList @(
                        "/i",
                        "`"$($msi.FullName)`"",
                        "/qn",
                        "/norestart",
                        "/L*v",
                        "`"$installLog`""
                    ) `
                    -Wait `
                    -PassThru

                Write-Log "VirtIO MSI exit code: $($process.ExitCode)"

                if ($process.ExitCode -notin @(0, 3010)) {
                    throw "VirtIO MSI installation failed with exit code $($process.ExitCode)."
                }

                Write-Log "VirtIO MSI installed successfully." Green

                if (Test-ActiveNetwork) {
                    return $true
                }

                if (Wait-ForNetwork -TimeoutSeconds 60) {
                    return $true
                }
            }

        }
        catch {
            Write-Log `
                "VirtIO MSI installation failed on $drive : $($_.Exception.Message)" `
                Yellow
        }

        Write-Log "Searching for NetKVM INF drivers..."

        try {

            $drivers = @(
                Get-ChildItem `
                    -Path $drive `
                    -Filter "*.inf" `
                    -File `
                    -Recurse `
                    -ErrorAction SilentlyContinue |
                    Where-Object {
                        $_.FullName -match "(?i)\\NetKVM\\"
                    }
            )

            foreach ($driver in $drivers) {

                Write-Log "Installing network driver:"
                Write-Log "  $($driver.FullName)"

                & pnputil.exe `
                    /add-driver `
                    "`"$($driver.FullName)`"" `
                    /install

                Write-Log "pnputil exit code: $LASTEXITCODE"
            }

            if (Wait-ForNetwork -TimeoutSeconds 60) {
                return $true
            }

        }
        catch {
            Write-Log `
                "INF driver installation failed: $($_.Exception.Message)" `
                Yellow
        }
    }

    return $false
}

# ============================================================
# HTTP REDIRECT
# ============================================================

function Get-RedirectDestination {

    param(
        [Parameter(Mandatory = $true)]
        [string]$Url
    )

    Write-Log "Resolving redirect:"
    Write-Log "  $Url"

    $handler = New-Object System.Net.Http.HttpClientHandler
    $handler.AllowAutoRedirect = $false

    $client = New-Object System.Net.Http.HttpClient($handler)

    try {

        $response = $client.GetAsync(
            $Url,
            [System.Net.Http.HttpCompletionOption]::ResponseHeadersRead
        ).GetAwaiter().GetResult()

        $statusCode = [int]$response.StatusCode

        Write-Log "HTTP status: $statusCode"

        if ($statusCode -in @(301, 302, 303, 307, 308)) {

            $location = $response.Headers.Location

            if (-not $location) {
                throw "Redirect response contained no Location header."
            }

            return $location.AbsoluteUri
        }

        throw "Expected an HTTP redirect but received HTTP $statusCode."
    }
    finally {
        $client.Dispose()
        $handler.Dispose()
    }
}

# ============================================================
# DOWNLOAD
# ============================================================

function Download-File {

    param(
        [Parameter(Mandatory = $true)]
        [string]$Url,

        [Parameter(Mandatory = $true)]
        [string]$Destination
    )

    Write-Log "Downloading:"
    Write-Log "  $Url"

    Write-Log "Destination:"
    Write-Log "  $Destination"

    Invoke-WebRequest `
        -Uri $Url `
        -OutFile $Destination `
        -UseBasicParsing

    if (-not (Test-Path $Destination)) {
        throw "Download failed: $Destination does not exist."
    }

    $size = (Get-Item $Destination).Length

    if ($size -le 0) {
        throw "Downloaded file is empty: $Destination"
    }

    Write-Log "Download completed: $size bytes." Green
}

# ============================================================
# CHECKSUM
# ============================================================

function Get-ExpectedSha256 {

    param(
        [Parameter(Mandatory = $true)]
        [string]$ChecksumText,

        [Parameter(Mandatory = $true)]
        [string]$FileName
    )

    $escapedName = [regex]::Escape($FileName)

    # Optional directory prefix in front of the file name,
    # e.g. "./", "virtio-win-0.1.285/" or "amd64\".
    $pathPrefix = '(?:[^\s*()]*[/\\])?'

    # Format:
    # HASH *filename   /   HASH  path/filename

    $match = [regex]::Match(
        $ChecksumText,
        "(?im)^\s*([0-9a-f]{64})\s+\*?$pathPrefix$escapedName\s*$"
    )

    if ($match.Success) {
        return $match.Groups[1].Value.ToLowerInvariant()
    }

    # Format:
    # SHA256 (filename) = HASH   /   SHA2-256(path/filename)= HASH

    $match = [regex]::Match(
        $ChecksumText,
        "(?im)^\s*SHA(?:2-)?256\s*\(\s*$pathPrefix$escapedName\s*\)\s*=\s*([0-9a-f]{64})\s*$"
    )

    if ($match.Success) {
        return $match.Groups[1].Value.ToLowerInvariant()
    }

    # Format:
    # filename HASH   /   path/filename: HASH

    $match = [regex]::Match(
        $ChecksumText,
        "(?im)^\s*$pathPrefix$escapedName\s*:?\s+([0-9a-f]{64})\s*$"
    )

    if ($match.Success) {
        return $match.Groups[1].Value.ToLowerInvariant()
    }

    Write-Log "Checksum file contents (no entry matched ${FileName}):" Yellow
    foreach ($line in ($ChecksumText -split "\r?\n")) {
        Write-Log "  $line"
    }

    throw "Could not find SHA-256 checksum for $FileName."
}

# ============================================================
# ONLINE VIRTIO INSTALLATION
# ============================================================

function Install-VirtIOOnline {

    Write-Section "VirtIO Online Installation"

    $stableUrl =
        "https://fedorapeople.org/groups/virt/virtio-win/direct-downloads/stable-virtio/"

    $virtioBaseUrl = Get-RedirectDestination -Url $stableUrl

    $virtioBaseUrl = $virtioBaseUrl.TrimEnd("/")

    Write-Log "Current VirtIO release:"
    Write-Log "  $virtioBaseUrl" Green

    $msiUrl =
        "$virtioBaseUrl/virtio-win-gt-x64.msi"

    $guestToolsUrl =
        "$virtioBaseUrl/virtio-win-guest-tools.exe"

    $msiFile =
        Join-Path $VirtIODirectory "virtio-win-gt-x64.msi"

    $guestToolsFile =
        Join-Path $VirtIODirectory "virtio-win-guest-tools.exe"

    $installLog =
        Join-Path $VirtIODirectory "virtio-online-install.log"

    Download-File `
        -Url $msiUrl `
        -Destination $msiFile

    # The release CHECKSUM file only lists the RPMs (MD5), not the
    # MSI, so the MSI is verified by its Authenticode signature.

    Write-Log "Verifying VirtIO MSI Authenticode signature..."

    $signature =
        Get-AuthenticodeSignature `
            -FilePath $msiFile

    $signer =
        $signature.SignerCertificate

    Write-Log "Signature status:"
    Write-Log "  $($signature.Status)"

    Write-Log "Signer:"
    Write-Log "  $($signer.Subject)"

    Write-Log "Issuer:"
    Write-Log "  $($signer.Issuer)"

    Write-Log "SHA-256:"
    Write-Log "  $((Get-FileHash -Path $msiFile -Algorithm SHA256).Hash.ToLowerInvariant())"

    if ($signature.Status -ne [System.Management.Automation.SignatureStatus]::Valid) {
        throw "VirtIO MSI signature is not valid ($($signature.Status)): $($signature.StatusMessage) Installation refused."
    }

    if ($signer.Subject -notmatch '(?i)\bO="?Red Hat') {
        throw "VirtIO MSI is signed by an unexpected publisher: $($signer.Subject). Installation refused."
    }

    Write-Log "Signature verification successful." Green

    Write-Log "Installing VirtIO Guest Tools MSI..."

    $process = Start-Process `
        -FilePath "msiexec.exe" `
        -ArgumentList @(
            "/i",
            "`"$msiFile`"",
            "/qn",
            "/norestart",
            "/L*v",
            "`"$installLog`""
        ) `
        -Wait `
        -PassThru

    Write-Log "VirtIO MSI exit code: $($process.ExitCode)"

    if ($process.ExitCode -notin @(0, 3010)) {
        throw "VirtIO MSI installation failed with exit code $($process.ExitCode)."
    }

    Write-Log "VirtIO MSI installation completed." Green

    # The guest tools executable is downloaded but not
    # automatically installed.
    Write-Log "Downloading QEMU Guest Tools..."

    Download-File `
        -Url $guestToolsUrl `
        -Destination $guestToolsFile

    Write-Log "QEMU Guest Tools saved to:"
    Write-Log "  $guestToolsFile" Green

    return $true
}

# ============================================================
# 1. VIRTIO / NETWORK BOOTSTRAP
# ============================================================

Write-Section "VirtIO / Network Bootstrap"

if (Test-ActiveNetwork) {

    Write-Log "Usable network connection already exists." Green

}
else {

    Write-Log "No usable Internet network detected." Yellow

    $mediaNetwork =
        Install-VirtIODriversFromMedia

    if (-not $mediaNetwork) {

        Write-Host ""
        Write-Host "No usable network connection was established." `
            -ForegroundColor Yellow

        Write-Host ""
        Read-Host "Insert or mount the VirtIO ISO, then press ENTER"

        Write-Log "Rescanning for VirtIO media..."

        if (-not (Install-VirtIODriversFromMedia)) {
            throw "Unable to establish a usable network connection using VirtIO media."
        }
    }
}

if (-not (Test-ActiveNetwork)) {
    throw "Network is still unavailable after VirtIO bootstrap."
}

Write-Log "Network bootstrap complete." Green

Install-VirtIOOnline

# ============================================================
# 2. COMPUTER NAME
# ============================================================

Write-Section "Computer Name"

$currentComputerName = $env:COMPUTERNAME

do {

    $computerName =
        Read-Host "Computer name [$currentComputerName]"

    if ([string]::IsNullOrWhiteSpace($computerName)) {
        $computerName = $currentComputerName
    }

    if (
        $computerName.Length -gt 15 -or
        $computerName -notmatch "^[A-Za-z0-9][A-Za-z0-9-]*[A-Za-z0-9]$"
    ) {

        Write-Log `
            "Invalid computer name. Maximum 15 characters; letters, numbers and hyphens only." `
            Yellow

        $computerName = $null
    }

}
while (-not $computerName)

if ($computerName -ne $currentComputerName) {

    Rename-Computer `
        -NewName $computerName `
        -Force

    Write-Log `
        "Computer will be renamed to $computerName." `
        Green

}
else {

    Write-Log "Computer name remains $currentComputerName."
}

# ============================================================
# 3. TIME ZONE
# ============================================================

Write-Section "Time Zone"

$timeZones = @(
    Get-TimeZone -ListAvailable |
        Sort-Object Id
)

$currentTimeZone = (Get-TimeZone).Id

Write-Log "Current time zone: $currentTimeZone"

$timeZoneSearch =
    Read-Host `
        "Enter time zone ID or part of display name (ENTER keeps current)"

if (-not [string]::IsNullOrWhiteSpace($timeZoneSearch)) {

    $matches = @(
        $timeZones |
            Where-Object {
                $_.Id -like "*$timeZoneSearch*" -or
                $_.DisplayName -like "*$timeZoneSearch*"
            }
    )

    if ($matches.Count -eq 0) {
        throw "No time zone matched '$timeZoneSearch'."
    }

    if ($matches.Count -eq 1) {

        $selectedTimeZone = $matches[0]

    }
    else {

        Write-Host ""

        for ($i = 0; $i -lt $matches.Count; $i++) {

            Write-Host `
                "[$($i + 1)] $($matches[$i].Id) - $($matches[$i].DisplayName)"
        }

        do {

            $selection =
                Read-Host "Select time zone"

            $number = 0

            $valid =
                [int]::TryParse(
                    $selection,
                    [ref]$number
                )

        }
        while (
            -not $valid -or
            $number -lt 1 -or
            $number -gt $matches.Count
        )

        $selectedTimeZone =
            $matches[$number - 1]
    }

    Set-TimeZone `
        -Id $selectedTimeZone.Id

    Write-Log `
        "Time zone set to $($selectedTimeZone.Id)." `
        Green

}
else {

    Write-Log "Time zone unchanged."
}

# ============================================================
# 4. WINDOWS SERVER EDITION
# ============================================================

Write-Section "Windows Server Edition"

Write-Log "Reading available target editions from DISM..."

$dismOutput =
    & dism.exe /online /Get-TargetEditions 2>&1

if ($LASTEXITCODE -ne 0) {
    throw "DISM /Get-TargetEditions failed with exit code $LASTEXITCODE."
}

$editionKeys = @{
    "ServerStandard" =
        "TVRH6-WHNXV-R9WG3-9XRFY-MY832"

    "ServerDatacenter" =
        "D764K-2NDRG-47T6Q-P8T8W-YP6DF"
}

$targetEditions = @(
    $dismOutput |
        ForEach-Object {

            if (
                $_ -match `
                "Target Edition\s*:\s*(.+?)\s*$"
            ) {
                $matches[1].Trim()
            }
        } |
        Where-Object {
            $_ -and
            $editionKeys.ContainsKey($_)
        } |
        Select-Object -Unique
)

if ($targetEditions.Count -eq 0) {
    throw "No supported ServerStandard or ServerDatacenter target edition was found."
}

for ($i = 0; $i -lt $targetEditions.Count; $i++) {
    Write-Host "[$($i + 1)] $($targetEditions[$i])"
}

do {

    $selection =
        Read-Host "Select target edition"

    $number = 0

    $valid =
        [int]::TryParse(
            $selection,
            [ref]$number
        )

}
while (
    -not $valid -or
    $number -lt 1 -or
    $number -gt $targetEditions.Count
)

$edition =
    $targetEditions[$number - 1]

$editionKey =
    $editionKeys[$edition]

Write-Log "Selected edition: $edition" Green

# ============================================================
# 5. TEMPLATE ID
# ============================================================

Write-Section "Template ID"

do {

    $templateID =
        Read-Host "Enter template ID (01-99)"

    $validTemplateID = (
        $templateID -match "^\d{1,2}$" -and
        [int]$templateID -ge 1 -and
        [int]$templateID -le 99
    )

    if (-not $validTemplateID) {

        Write-Log `
            "Template ID must be a number from 01 to 99." `
            Yellow
    }

}
while (-not $validTemplateID)

$templateID =
    ([int]$templateID).ToString("00")

Write-Log "Template ID: $templateID" Green

# ============================================================
# 6. NETWORK CONFIGURATION
# ============================================================

Write-Section "Network Configuration"

$adapter =
    Get-NetAdapter |
        Where-Object {
            $_.HardwareInterface -eq $true
        } |
        Sort-Object ifIndex |
        Select-Object -First 1

if (-not $adapter) {
    throw "No physical network adapter was found."
}

Write-Log "Using network adapter:"
Write-Log "  Name:      $($adapter.Name)"
Write-Log "  Interface: $($adapter.ifIndex)"
Write-Log "  MAC:       $($adapter.MacAddress)"

$dhcpIPv4 =
    Get-NetIPAddress `
        -InterfaceIndex $adapter.ifIndex `
        -AddressFamily IPv4 `
        -ErrorAction SilentlyContinue |
        Where-Object {
            $_.PrefixOrigin -eq "Dhcp" -and
            $_.IPAddress -notlike "169.254.*"
        } |
        Select-Object -First 1

if ($dhcpIPv4) {

    Write-Log `
        "DHCP IPv4 address detected: $($dhcpIPv4.IPAddress)"

    $octets =
        $dhcpIPv4.IPAddress.Split(".")

    if ($octets.Count -ne 4) {
        throw "Unexpected IPv4 address format: $($dhcpIPv4.IPAddress)"
    }

    $staticIP =
        "$($octets[0]).$($octets[1]).$($octets[2]).$templateID"

    $defaultRoute =
        Get-NetRoute `
            -InterfaceIndex $adapter.ifIndex `
            -AddressFamily IPv4 `
            -DestinationPrefix "0.0.0.0/0" `
            -ErrorAction SilentlyContinue |
            Sort-Object RouteMetric |
            Select-Object -First 1

    if (-not $defaultRoute) {
        throw "No DHCP default gateway was found."
    }

    $gateway =
        $defaultRoute.NextHop

    $prefixLength = 24

    $dnsServers =
        @("1.1.1.1")

    Write-Host ""
    Write-Host "DHCP-derived static configuration:"
    Write-Host "  IP:      $staticIP/$prefixLength"
    Write-Host "  Gateway: $gateway"
    Write-Host "  DNS:     $($dnsServers -join ', ')"

    $confirm =
        Read-Host "Apply this configuration? [Y/n]"

    if (
        -not [string]::IsNullOrWhiteSpace($confirm) -and
        $confirm -notmatch "^[Yy]"
    ) {

        $staticIP =
            Read-Host "IPv4 address"

        $prefixLength =
            24

        $gateway =
            Read-Host "Default gateway"

        $dnsInput =
            Read-Host "DNS server(s), comma separated"

        $dnsServers = @(
            $dnsInput.Split(",") |
                ForEach-Object {
                    $_.Trim()
                } |
                Where-Object {
                    $_
                }
        )
    }

}
else {

    Write-Log "No DHCP IPv4 address detected."

    $staticIP =
        Read-Host "IPv4 address"

    $subnetMask =
        Read-Host "Subnet mask"

    $gateway =
        Read-Host "Default gateway"

    $dnsInput =
        Read-Host "DNS server(s), comma separated"

    $dnsServers = @(
        $dnsInput.Split(",") |
            ForEach-Object {
                $_.Trim()
            } |
            Where-Object {
                $_
            }
    )

    function Convert-SubnetMaskToPrefixLength {

        param(
            [Parameter(Mandatory = $true)]
            [string]$Mask
        )

        $parts =
            $Mask.Split(".")

        if ($parts.Count -ne 4) {
            throw "Invalid subnet mask: $Mask"
        }

        $binary = ""

        foreach ($part in $parts) {

            $octet = 0

            if (
                -not [int]::TryParse(
                    $part,
                    [ref]$octet
                ) -or
                $octet -lt 0 -or
                $octet -gt 255
            ) {
                throw "Invalid subnet mask: $Mask"
            }

            $binary +=
                [Convert]::ToString(
                    $octet,
                    2
                ).PadLeft(8, "0")
        }

        if ($binary -notmatch "^1*0*$") {
            throw "Subnet mask is not contiguous: $Mask"
        }

        return (
            $binary.ToCharArray() |
                Where-Object {
                    $_ -eq "1"
                }
        ).Count
    }

    $prefixLength =
        Convert-SubnetMaskToPrefixLength `
            -Mask $subnetMask
}

if (
    $prefixLength -lt 1 -or
    $prefixLength -gt 32
) {
    throw "Invalid prefix length: $prefixLength."
}

Write-Log "Applying static IPv4 configuration..."

Get-NetIPAddress `
    -InterfaceIndex $adapter.ifIndex `
    -AddressFamily IPv4 `
    -ErrorAction SilentlyContinue |
    Remove-NetIPAddress `
        -Confirm:$false `
        -ErrorAction SilentlyContinue

Get-NetRoute `
    -InterfaceIndex $adapter.ifIndex `
    -AddressFamily IPv4 `
    -DestinationPrefix "0.0.0.0/0" `
    -ErrorAction SilentlyContinue |
    Remove-NetRoute `
        -Confirm:$false `
        -ErrorAction SilentlyContinue

Set-NetIPInterface `
    -InterfaceIndex $adapter.ifIndex `
    -AddressFamily IPv4 `
    -Dhcp Disabled

New-NetIPAddress `
    -InterfaceIndex $adapter.ifIndex `
    -IPAddress $staticIP `
    -PrefixLength $prefixLength `
    -DefaultGateway $gateway

Set-DnsClientServerAddress `
    -InterfaceIndex $adapter.ifIndex `
    -ServerAddresses $dnsServers

Write-Log "Static network configuration applied." Green

# ============================================================
# 7. ENABLE RDP
# ============================================================

Write-Section "Remote Desktop"

Set-ItemProperty `
    -Path "HKLM:\System\CurrentControlSet\Control\Terminal Server" `
    -Name "fDenyTSConnections" `
    -Value 0

Enable-NetFirewallRule `
    -DisplayGroup "Remote Desktop"

Write-Log "Remote Desktop enabled." Green

# ============================================================
# 8. GOOGLE CHROME
# ============================================================

Write-Section "Google Chrome"

if (-not (Get-Command winget.exe -ErrorAction SilentlyContinue)) {
    throw "winget.exe was not found."
}

Write-Log "Installing Google Chrome..."

& winget.exe install `
    --id Google.Chrome `
    --exact `
    --silent `
    --accept-package-agreements `
    --accept-source-agreements

Write-Log "winget Chrome exit code: $LASTEXITCODE"

if ($LASTEXITCODE -ne 0) {
    throw "Google Chrome installation failed with exit code $LASTEXITCODE."
}

Write-Log "Google Chrome installed." Green

# ============================================================
# 9. 7-ZIP
# ============================================================

Write-Section "7-Zip"

Write-Log "Installing 7-Zip..."

& winget.exe install `
    --id 7zip.7zip `
    --exact `
    --silent `
    --accept-package-agreements `
    --accept-source-agreements

Write-Log "winget 7-Zip exit code: $LASTEXITCODE"

if ($LASTEXITCODE -ne 0) {
    throw "7-Zip installation failed with exit code $LASTEXITCODE."
}

Write-Log "7-Zip installed." Green

# ============================================================
# 10. INITIAL WINDOWS UPDATE
# ============================================================

Write-Section "Initial Windows Update"

Write-Log "Creating Windows Update session..."

$updateSession =
    New-Object -ComObject Microsoft.Update.Session

$updateSearcher =
    $updateSession.CreateUpdateSearcher()

Write-Log "Searching for applicable updates..."

$searchResult =
    $updateSearcher.Search(
        "IsInstalled=0 and IsHidden=0 and Type='Software'"
    )

$updates = @(
    $searchResult.Updates
)

Write-Log "Updates found: $($updates.Count)"

if ($updates.Count -gt 0) {

    $updatesToInstall =
        New-Object -ComObject Microsoft.Update.UpdateColl

    foreach ($update in $updates) {

        try {

            if (-not $update.EulaAccepted) {
                $update.AcceptEula()
            }

        }
        catch {}

        [void]$updatesToInstall.Add($update)
    }

    Write-Log "Downloading updates..."

    $downloader =
        $updateSession.CreateUpdateDownloader()

    $downloader.Updates =
        $updatesToInstall

    $downloadResult =
        $downloader.Download()

    Write-Log `
        "Windows Update download result: $($downloadResult.ResultCode)"

    Write-Log "Installing updates..."

    $installer =
        $updateSession.CreateUpdateInstaller()

    $installer.Updates =
        $updatesToInstall

    $installResult =
        $installer.Install()

    Write-Log `
        "Windows Update installation result: $($installResult.ResultCode)"

    Write-Log `
        "Windows Update reboot required: $($installResult.RebootRequired)"
}
else {

    Write-Log "No applicable Windows Updates found."
}

# ============================================================
# 11. POST-REBOOT WINDOWS UPDATE
# ============================================================

Write-Section "Post-Reboot Windows Update"

$postRebootScript =
    Join-Path `
        $InstallDirectory `
        "Server2025-PostRebootUpdate.ps1"

$postRebootLog =
    Join-Path `
        $InstallDirectory `
        "Server2025-PostRebootUpdate.log"

$taskName =
    "Server2025-PostRebootUpdate"

$postRebootContent = @'
$ErrorActionPreference = "Continue"

$InstallDirectory = "C:\propstatInstallScript"
$LogFile = Join-Path $InstallDirectory "Server2025-PostRebootUpdate.log"

New-Item `
    -ItemType Directory `
    -Path $InstallDirectory `
    -Force `
    -ErrorAction SilentlyContinue |
    Out-Null

function Write-Log {
    param(
        [string]$Message
    )

    $timestamp =
        Get-Date -Format "yyyy-MM-dd HH:mm:ss"

    Add-Content `
        -Path $LogFile `
        -Value "[$timestamp] $Message" `
        -ErrorAction SilentlyContinue
}

Write-Log "============================================================"
Write-Log "Post-reboot Windows Update task started."
Write-Log "============================================================"

try {

    Write-Log "Waiting 30 seconds for Windows services."

    Start-Sleep -Seconds 30

    Write-Log "Creating Windows Update session."

    $session =
        New-Object -ComObject Microsoft.Update.Session

    $searcher =
        $session.CreateUpdateSearcher()

    Write-Log "Searching for remaining updates."

    $result =
        $searcher.Search(
            "IsInstalled=0 and IsHidden=0 and Type='Software'"
        )

    $updates = @(
        $result.Updates
    )

    Write-Log "Updates found: $($updates.Count)"

    if ($updates.Count -gt 0) {

        $collection =
               New-Object -ComObject Microsoft.Update.UpdateColl

        foreach ($update in $updates) {

            try {

                if (-not $update.EulaAccepted) {
                    $update.AcceptEula()
                }

            }
            catch {}

            [void]$collection.Add($update)
        }

        Write-Log "Downloading updates."

        $downloader =
            $session.CreateUpdateDownloader()

        $downloader.Updates =
            $collection

        $downloadResult =
            $downloader.Download()

        Write-Log `
            "Download result: $($downloadResult.ResultCode)"

        Write-Log "Installing updates."

        $installer =
            $session.CreateUpdateInstaller()

        $installer.Updates =
            $collection

        $installResult =
            $installer.Install()

        Write-Log `
            "Installation result: $($installResult.ResultCode)"

        Write-Log `
            "Reboot required: $($installResult.RebootRequired)"

    }
    else {

        Write-Log "No additional updates found."
    }

}
catch {

    Write-Log "ERROR: $($_.Exception.Message)"
    Write-Log ($_ | Out-String)

}
finally {

    Write-Log "Removing scheduled task."

    try {

        Unregister-ScheduledTask `
            -TaskName "Server2025-PostRebootUpdate" `
            -Confirm:$false `
            -ErrorAction SilentlyContinue

    }
    catch {}

    Write-Log "Post-reboot update task completed."
}
'@

Set-Content `
    -Path $postRebootScript `
    -Value $postRebootContent `
    -Encoding UTF8

$action =
    New-ScheduledTaskAction `
        -Execute (Join-Path $env:ProgramFiles "PowerShell\7\pwsh.exe") `
        -Argument `
            "-NoProfile -ExecutionPolicy Bypass -File `"$postRebootScript`""

$trigger =
    New-ScheduledTaskTrigger `
        -AtStartup

$principal =
    New-ScheduledTaskPrincipal `
        -UserId "SYSTEM" `
        -LogonType ServiceAccount `
        -RunLevel Highest

$settings =
    New-ScheduledTaskSettingsSet `
        -StartWhenAvailable

Register-ScheduledTask `
    -TaskName $taskName `
    -Action $action `
    -Trigger $trigger `
    -Principal $principal `
    -Settings $settings `
    -Force |
    Out-Null

Write-Log `
    "Post-reboot Windows Update task registered." `
    Green

# ============================================================
# 12. EDITION CONVERSION
# ============================================================

Write-Section "Windows Server Edition Conversion"

Write-Log "Target edition:"
Write-Log "  $edition"

Write-Log "Running DISM edition conversion..."

& dism.exe `
    /online `
    "/Set-Edition:$edition" `
    "/ProductKey:$editionKey" `
    /AcceptEula

Write-Log "DISM exit code: $LASTEXITCODE"

if ($LASTEXITCODE -ne 0) {
    throw "DISM edition conversion failed with exit code $LASTEXITCODE."
}

Write-Log "Edition conversion completed successfully." Green

# ============================================================
# 13. FINAL REBOOT
# ============================================================

Write-Section "Reboot"

Write-Log "Provisioning is complete." Green
Write-Log ""
Write-Log "The system will reboot in 15 seconds."
Write-Log ""
Write-Log "The post-reboot Windows Update task will:"
Write-Log "  1. Wait for Windows to initialize."
Write-Log "  2. Perform one additional Windows Update pass."
Write-Log "  3. Write its results to:"
Write-Log "     $postRebootLog"
Write-Log "  4. Remove itself."
Write-Log ""

for ($i = 15; $i -gt 0; $i--) {

    Write-Host `
        "`rRebooting in $i seconds... " `
        -NoNewline

    Start-Sleep -Seconds 1
}

Write-Host ""
Write-Log "Rebooting now..." Yellow

try {
    Stop-Transcript | Out-Null
}
catch {}

try {

    Restart-Computer -Force

}
catch {

    Write-Host ""
    Write-Host "============================================================" `
        -ForegroundColor Red
    Write-Host "REBOOT FAILED" `
        -ForegroundColor Red
    Write-Host "============================================================" `
        -ForegroundColor Red
    Write-Host ""
    Write-Host $_.Exception.Message `
        -ForegroundColor Red
    Write-Host ""
    Write-Host "The PowerShell window will remain open." `
        -ForegroundColor Yellow

    Wait-Forever
}

# If Restart-Computer unexpectedly returns, do not close.
Wait-Forever
